# Response headers for every file, read by Cloudflare (Workers static assets). Not served as a page. Shipped as written:
# nothing fills it in at build.
# Content-Security-Policy: the whole policy is this one header (docs/security.md). A header, not a <meta> in the
# page: with the <meta>, Chrome read and laid out the whole page before it painted any of it.
#   default-src 'none'              a kind of file the policy doesn't name is refused
#   script-src                      the site's own files, Cloudflare Web Analytics' beacon, and one inline script by its
#                                   hash: the theme script (src/scripts/theme-init.js). The build stops when that
#                                   file and this hash part ways, and prints the hash to put here (src/lib/csp.ts)
#   style-src-elem 'unsafe-inline'  each page carries its CSS inside it (astro.config.mjs, inlineStylesheets), and a
#                                   hash for it would change with every page and every edit, which a header written
#                                   by hand can't follow. style-src says the same for a browser without -elem
#   style-src-attr 'none'           a style="" attribute does nothing
#   connect-src                     the site, and the beacon's reports to cloudflareinsights.com
#   frame-ancestors 'none'          no other site may show these pages in a frame
#   require-trusted-types-for / trusted-types   scripts may write HTML (innerHTML and the like) only through the
#                                   'uplink' policy in core.js (its html() helper)
# Strict-Transport-Security: a year, every subdomain, and "preload": the browser asks for https only.
# X-Robots-Tag noindex: keeps the whole site out of search results while it is a test build. Delete the line at launch.
# Speculation-Rules: Chrome and Edge fetch a page in the background when a pointer rests on a link to it (on phones,
# when it comes into view), so the click doesn't wait for the HTML. The rules are public/speculation-rules.json.
# Nothing is fetched ahead before that: each page carries its own CSS (about 25 KB a page), so fetching the menu's
# pages as Home opens would cost every visitor about 100 KB for pages most never open.
/*
  X-Robots-Tag: noindex
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  Speculation-Rules: "/speculation-rules.json"
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com 'sha256-/PruTeEqor+xy7dXQcR6QScj6SUK6MRNn/jsG1cVD9o='; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'none'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types uplink

# Cloudflare sends .txt as text/plain with no charset, and browsers then read it as windows-1252 ("doesnâ€™t").
# The files are UTF-8: say so. Named one by one, so a missing .txt address still gets the 404 page as a page.
/robots.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
/llms.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
# the commit the live build was made from: never kept, so a check after a deploy reads the new one
/version.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store
# Chrome reads speculation rules only under their own type (Cloudflare would send application/json).
/speculation-rules.json
  ! Content-Type
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=86400

# The icons and the speculation rules keep their plain names and rarely change: a day, so a visitor's next pages
# don't ask Cloudflare for them again (its default is to check every time).
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Astro names every bundled JS file, every font (/_astro/fonts/) and every drawing by its content hash, so a year
# is safe.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# The share picture is fetched by social sites by its plain name: a day only. Some apps show it straight from here
# in their own pages, so it may be loaded cross-origin (every other file is same-origin only).
/assets/img/og.png
  Cache-Control: public, max-age=86400
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
