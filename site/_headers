# @end early-hints

# CSS and JS are linked with ?v=<hash> (tools/stamp.py), so browsers can keep them for a year.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
# Fonts are self-hosted and never edited in place: a new version gets a new file name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images are linked with ?v=<hash> too (tools/stamp.py), so the same year-long cache.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
# The share picture is fetched by its plain name (og:image), with no stamp: a day only.
/assets/img/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
