  Link: </assets/fonts/barlow-condensed-700-italic.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </assets/fonts/barlow-400.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </assets/fonts/barlow-600.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin
