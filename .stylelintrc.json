{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "declaration-block-single-line-max-declarations": null,
    "comment-empty-line-before": null,
    "comment-whitespace-inside": null,
    "at-rule-empty-line-before": null,
    "rule-empty-line-before": null,
    "declaration-empty-line-before": null,
    "custom-property-empty-line-before": null,
    "media-feature-range-notation": "context",
    "selector-class-pattern": null,
    "import-notation": "string",
    "alpha-value-notation": "number",
    "no-descending-specificity": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "property-no-vendor-prefix": null,
    "property-no-deprecated": null,
    "font-family-name-quotes": null,
    "declaration-property-unit-disallowed-list": [
      {
        "font-size": ["px", "vw", "vh", "svh", "dvh", "lvh", "vmin", "vmax"],
        "/^(margin|padding|gap|row-gap|column-gap)/": ["px"]
      },
      {
        "severity": "warning",
        "message": "Off the design system: use a --fs-* or --sp-* token (docs/design.md), or mark a one-off with a stylelint-disable comment saying why"
      }
    ],
    "media-feature-name-unit-allowed-list": [
      { "width": ["em"], "height": ["em"] },
      { "severity": "warning", "message": "Breakpoints are in em, by the names in src/lib/media.js" }
    ],
    "property-disallowed-list": [
      [
        "border-left",
        "border-left-width",
        "border-left-color",
        "border-inline-start",
        "border-inline-start-width",
        "border-inline-start-color"
      ],
      { "severity": "warning", "message": "No left-side accent borders (docs/design.md, colour rule 11)" }
    ],
    "length-zero-no-unit": [
      true,
      {
        "ignoreFunctions": ["env"]
      }
    ],
    "value-keyword-case": [
      "lower",
      {
        "camelCaseSvgKeywords": true,
        "ignoreKeywords": ["optimizeLegibility", "Roboto", "Helvetica", "Arial"]
      }
    ]
  }
}
