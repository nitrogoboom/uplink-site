{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "declaration-block-single-line-max-declarations": null,
    "comment-empty-line-before": null,
    "comment-whitespace-inside": null,
    "at-rule-empty-line-before": null,
    "rule-empty-line-before": null,
    "declaration-empty-line-before": null,
    "custom-property-empty-line-before": null,
    "media-feature-range-notation": "context",
    "selector-class-pattern": null,
    "import-notation": "string",
    "alpha-value-notation": "number",
    "no-descending-specificity": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "property-no-vendor-prefix": null,
    "property-no-deprecated": null,
    "font-family-name-quotes": null,
    "length-zero-no-unit": [true, { "ignoreFunctions": ["env"] }],
    "declaration-property-value-disallowed-list": [
      {
        "/^(margin|padding|gap|row-gap|column-gap|scroll-margin|scroll-padding)/": [
          "/(?<![\\w.])(?:\\d*\\.\\d+|[1-9]\\d*)(?:px|rem|em)\\b/"
        ],
        "/^(font|font-size|--fs-.+)$/": ["/\\dpx\\b/"],
        "/^(font|font-size)$/": ["/\\d(vw|vh|vi|vb|vmin|vmax|svw|svh|lvw|lvh|dvw|dvh)\\b/"]
      },
      {
        "message": "Spacing takes a --sp-* token. Text size takes a --fs-* token: never px, and never the screen (vw, svh) outside a token (docs/design.md)"
      }
    ],
    "declaration-property-value-allowed-list": [
      { "line-height": ["/^var\\(--lh-[a-z]+\\)$/", "inherit", "normal"] },
      { "message": "Line height takes a --lh-* token (docs/design.md, R7)" }
    ],
    "property-disallowed-list": [
      ["/^border-(left|inline-start)/"],
      {
        "message": "No left-side accent: a card or tab has even borders (docs/design.md, Layout). A real divider says why in a stylelint-disable comment"
      }
    ],
    "media-feature-name-value-allowed-list": [
      { "/^(min-|max-)?(width|height)$/": ["/^-?[\\d.]+em$/"] },
      { "message": "Breakpoints are in em (src/README.md, Breakpoints)" }
    ],
    "value-keyword-case": [
      "lower",
      { "camelCaseSvgKeywords": true, "ignoreKeywords": ["optimizeLegibility", "Roboto", "Helvetica", "Arial"] }
    ]
  }
}
