---
// ABOUT. Sections in page order; each is one component in src/components/about/.
import Base from '../layouts/Base.astro';
import { PAGES } from '../lib/site';
import Profile from '../components/about/Profile.astro';
import Story from '../components/about/Story.astro';
import Team from '../components/about/Team.astro';
---
<Base title={PAGES.about.title} description={PAGES.about.description}
      page="about" path="/about" type="AboutPage">
  <Profile />
  <Story />
  <Team />
</Base>
