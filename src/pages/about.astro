---
// ABOUT. Sections in page order; each is one component in src/components/about/.
import Base from '../layouts/Base.astro';
import { pageMeta } from '../lib/site';
import Profile from '../components/about/Profile.astro';
import Process from '../components/about/Process.astro';
import Team from '../components/about/Team.astro';
const meta = await pageMeta('about');
---

<Base title={meta.title} description={meta.description} page="about" path="/about" type="AboutPage">
  <Profile />
  <Process />
  <Team />
</Base>
