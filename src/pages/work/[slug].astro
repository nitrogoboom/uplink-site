---
// One page per project (/work/office-move …), from src/content/projects/<slug>.json: ProjectCase laid out as a
// page (project-page.css): breadcrumb and title beside the drawing, the story and facts (its services link to
// their pages), then the full case study (the project's `page` fields).
import { getCollection, getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCase from '../../components/work/ProjectCase.astro';
import { PAGES, breadcrumbs, jsonLd } from '../../lib/site';
import '../../components/work/project-page.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { id, data: p } = project;
const url = new URL(`/work/${id}`, Astro.site).href;
const description = `${p.client}. ${p.result}.`;   // as the sitemap list and llms.txt say it (allPages in src/lib/site.ts)
const services = await getEntries(p.services);
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', '@id': url, url, headline: p.name, description, inLanguage: 'en-CA',
      publisher: { '@id': `${Astro.site!.href}#business` },
      about: services.map((s) => ({ '@id': new URL(`/services/${s.id}`, Astro.site).href })),
      articleBody: [...p.page.challenge, ...p.page.steps.map((t) => `${t.title}. ${t.detail}`), ...p.page.results].join('\n\n') },
    breadcrumbs([[PAGES.home.name, Astro.site!.href], [PAGES.work.name, new URL(PAGES.work.path, Astro.site).href], [p.name, url]]),
  ],
};
---
<Base title={`${p.name} · Uplink Technology`} description={description} page="work" path={`/work/${id}`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd(ld)} />
  </Fragment>
  <section class="hero proj-page" aria-labelledby={`case-${id}-t`}>
    <div class="container proj-page-grid">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol><li><a href="/work">Our work</a></li><li aria-current="page">{p.name}</li></ol>
      </nav>
      <ProjectCase project={project} />
    </div>
  </section>
  <section class="section section--band" aria-labelledby="story-title">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">Case study</p>
        <h2 id="story-title">How it went</h2>
      </div>
      <div class="stack-5 detail-body">
        <div class="prose">
          <h3>Where they started</h3>
          {p.page.challenge.map((t) => <p>{t}</p>)}
          <h3>What we did</h3>
          <ol>{p.page.steps.map((t) => <li><strong>{t.title}.</strong> {t.detail}</li>)}</ol>
          <h3>The result</h3>
          <ul>{p.page.results.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>
</Base>
