---
// One page per project (/work/office-move …), from src/content/projects/<slug>.json: the same ProjectCase the
// Work page lists, laid out as a page of its own (project-page.css): breadcrumb and title beside the drawing, the
// story and facts, a link to the next project, and the call-to-action band.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCase from '../../components/work/ProjectCase.astro';
import Icon from '../../components/Icon.astro';
import '../../components/work/details.css';
import '../../components/work/project-page.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({ params: { slug: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const { id, data: p } = project;
const url = new URL(`/work/${id}`, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', '@id': url, url, headline: p.name, description: p.story, inLanguage: 'en-CA',
      publisher: { '@id': `${Astro.site!.href}#business` }, about: p.services },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site!.href },
      { '@type': 'ListItem', position: 2, name: 'Our work', item: new URL('/work', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: p.name, item: url } ] },
  ],
};
---
<Base title={`${p.name} · Uplink Technology`} description={`${p.client}. ${p.story}`} page="work" path={`/work/${id}`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld, null, 1).replace(/<\//g, '<\\/')} />
  </Fragment>
  <section class="hero proj-page" aria-labelledby={`case-${id}-t`}>
    <div class="container proj-page-grid">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol><li><a href="/work">Our work</a></li><li aria-current="page">{p.name}</li></ol>
      </nav>
      <ProjectCase project={project} heading="h1" />
    </div>
  </section>
  <section class="section page-end" aria-label="More">
    <div class="container stack-5">
      <a class="next-link panel" href={`/work/${next.id}`}>
        <span class="label">Next project</span>
        <span class="next-title">{next.data.name}</span>
        <span class="next-line muted">{next.data.clientShort}</span>
        <Icon name="arrow" />
      </a>
      <div class="panel cta-band">
        <div class="stack">
          <h2>Want a result like this?</h2>
          <p class="lead">Start with the free check-up. We look first, then quote.</p>
        </div>
        <div class="row">
          <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog">Book a check-up</a>
          <a class="btn btn--secondary btn--lg" href="/work">All projects</a>
        </div>
      </div>
    </div>
  </section>
</Base>
