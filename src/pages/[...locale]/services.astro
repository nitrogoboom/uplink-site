---
// SERVICES. Sections in page order; each is one component in src/components/services/. The JSON-LD lists the
// FAQ and every Service (each pointing at its own page) from the collections.
import { linker } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import { businessRef, getFaq, pageMeta, getServices } from '../../lib/site';
import Overview from '../../components/services/Overview.astro';
import Faq from '../../components/services/Faq.astro';
import { localePaths } from '../../lib/i18n';
const to = linker(Astro.currentLocale);

export const getStaticPaths = localePaths;

const services = await getServices(Astro.currentLocale);
const faq = await getFaq(Astro.currentLocale);
const business = businessRef(Astro.site!);
const mainEntity = faq.map((f) => ({
  '@type': 'Question',
  name: f.q,
  acceptedAnswer: { '@type': 'Answer', text: f.a },
}));
const serviceNodes = services.map(({ id, data: s }) => {
  const url = new URL(to(`/services/${id}`), Astro.site).href;
  return {
    '@type': 'Service',
    '@id': url,
    url,
    name: s.title,
    description: s.lead,
    provider: business,
    areaServed: 'Ontario',
  };
});
const meta = await pageMeta('services', Astro.currentLocale);
---

<Base
  title={meta.title}
  description={meta.description}
  page="services"
  path="/services"
  type="FAQPage"
  ldPage={{ mainEntity }}
  ldGraph={serviceNodes}
>
  <Overview />
  <Faq />
</Base>
