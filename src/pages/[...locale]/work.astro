---
// OUR WORK. Sections in page order; each is one component in src/components/work/. No page script: the filters are
// radios, and the CSS that hides the other cards (workFilterCss(Astro.currentLocale) in lib/site.ts) goes in the <head>.
import Base from '../../layouts/Base.astro';
import { pageMeta, workFilterCss } from '../../lib/site';
import { sha256 } from '../../lib/csp';
import Projects from '../../components/work/Projects.astro';
import { localePaths } from '../../lib/i18n';

export const getStaticPaths = localePaths;
const filterCss = await workFilterCss(Astro.currentLocale);
Astro.csp?.insertStyleHash(sha256(filterCss));
const meta = await pageMeta('work', Astro.currentLocale);
---

<Base title={meta.title} description={meta.description} page="work" path="/work" type="CollectionPage">
  <Fragment slot="head"><style is:inline set:html={filterCss}></style></Fragment>
  <Projects />
</Base>
