---
// One page per service (/services/help-desk …), from src/content/services/<slug>.json. ServiceCard laid out as a
// page (service-page.css): breadcrumb and title beside the drawing, what's included, then how it works and its
// questions (the service's `page` fields), then the projects that used it (their `services` list). Its JSON-LD is
// the Service block the Services page also lists, its questions as a FAQPage, and a three-step breadcrumb.
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import '../../components/services/service-page.css';
import { PAGES, getServices, getProjects, breadcrumbs, jsonLd } from '../../lib/site';

export async function getStaticPaths() {
  const services = await getServices();
  const projects = await getProjects();
  return services.map((service, i) => ({ params: { slug: service.id }, props: { service, n: i + 1, total: services.length,
    projects: projects.filter((p) => p.data.services.some((r) => r.id === service.id)).slice(0, 3) } }));
}
const { service, n, total, projects } = Astro.props;
const { id, data: s } = service;
const url = new URL(`/services/${id}`, Astro.site).href;
const business = { '@id': `${Astro.site!.href}#business` };
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', '@id': url, url, name: s.title, description: s.lead, provider: business, areaServed: 'Ontario',
      subjectOf: { '@id': `${url}#questions` } },
    { '@type': 'FAQPage', '@id': `${url}#questions`, url, inLanguage: 'en-CA',
      mainEntity: s.page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    breadcrumbs([[PAGES.home.name, Astro.site!.href], [PAGES.services.name, new URL(PAGES.services.path, Astro.site).href], [s.title, url]]),
  ],
};
---
<Base title={`${s.title} · Uplink Technology`} description={s.lead} page="services" path={`/services/${id}`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd(ld)} />
  </Fragment>
  <section class="hero svc-page" aria-labelledby={`svc-${id}`}>
    <div class="container svc-page-grid">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol><li><a href="/services">Services</a></li><li aria-current="page">{s.title}</li></ol>
      </nav>
      <ServiceCard service={service} n={n} total={total} on first heading="h1" />
      <div class="svc-page-cta row">
        <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog" data-service={s.title}>Talk to us about this</a>
      </div>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="how-title">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">{s.page.heading}</h2>
      </div>
      <div class="stack-5 detail-body">
        <div class="prose">{s.page.body.map((t) => <p>{t}</p>)}</div>
      </div>
    </div>
  </section>
  <section class="section" id="questions" aria-labelledby="questions-title">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="questions-title">Questions about {s.title}</h2>
      </div>
      <div class="faq">
        {s.page.faq.map((f) => (
          <details>
            <summary>{f.q}<Icon name="plus" /></summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
  {projects.length > 0 && (
  <section class="section section--band" id="projects" aria-labelledby="projects-title">
    <div class="container stack-5">
      <div class="section-head">
        <p class="eyebrow">Our work</p>
        <h2 id="projects-title">Where we've done this</h2>
      </div>
      <ul class="card-row">
        {projects.map((project) => <li><ProjectCard project={project} /></li>)}
      </ul>
    </div>
  </section>
  )}
</Base>
