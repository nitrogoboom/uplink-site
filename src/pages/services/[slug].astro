---
// One page per service (/services/help-desk …), from src/content/services/<slug>.json. The same ServiceCard
// the picker shows, laid out as a page of its own (service-page.css): breadcrumb and title beside the drawing,
// what's included, then how it works and its questions (the service's `page` fields), a link to the next service,
// and the call-to-action band. Its JSON-LD is the Service block the Services page also lists, its questions as a
// FAQPage, and a three-step breadcrumb.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import Icon from '../../components/Icon.astro';
import '../../components/services/pick.css';
import '../../components/services/service-page.css';

export async function getStaticPaths() {
  const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  return services.map((service, i) => ({ params: { slug: service.id }, props: { service, n: i + 1, total: services.length, next: services[(i + 1) % services.length] } }));
}
const { service, n, total, next } = Astro.props;
const { id, data: s } = service;
const url = new URL(`/services/${id}`, Astro.site).href;
const business = { '@id': `${Astro.site!.href}#business` };
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', '@id': url, url, name: s.title, description: s.lead, provider: business, areaServed: 'Ontario',
      subjectOf: { '@id': `${url}#questions` } },
    { '@type': 'FAQPage', '@id': `${url}#questions`, url, inLanguage: 'en-CA',
      mainEntity: s.page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site!.href },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: s.title, item: url } ] },
  ],
};
---
<Base title={`${s.title} · Uplink Technology`} description={s.lead} page="services" path={`/services/${id}`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld, null, 1).replace(/<\//g, '<\\/')} />
  </Fragment>
  <section class="hero svc-page" aria-labelledby={`svc-${id}`}>
    <div class="container svc-page-grid">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol><li><a href="/services">Services</a></li><li aria-current="page">{s.title}</li></ol>
      </nav>
      <ServiceCard service={service} n={n} total={total} on first heading="h1" />
      <div class="svc-page-cta row">
        <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog" data-service={s.title}>Talk to us about this</a>
        <a class="link-arrow" href={`/services#${id}`}>Compare all services<Icon name="arrow" /></a>
      </div>
    </div>
  </section>
  <section class="section section--band" aria-labelledby="how-title">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">{s.page.heading}</h2>
      </div>
      <div class="stack-5 detail-body">
        <div class="prose">{s.page.body.map((t) => <p>{t}</p>)}</div>
        <dl class="facts">
          <div><dt>Plans</dt><dd>{s.page.plans}</dd></div>
          <div><dt>Price</dt><dd>Quoted after the free check-up</dd></div>
        </dl>
      </div>
    </div>
  </section>
  <section class="section" id="questions" aria-labelledby="questions-title">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="questions-title">Questions about {s.title}</h2>
      </div>
      <div class="faq">
        {s.page.faq.map((f) => (
          <details>
            <summary>{f.q}<Icon name="plus" /></summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section page-end" aria-label="More">
    <div class="container stack-5">
      <a class="next-link panel" href={`/services/${next.id}`}>
        <span class="label">Next service</span>
        <span class="next-title">{next.data.title}</span>
        <span class="next-line muted">{next.data.card}</span>
        <Icon name="arrow" />
      </a>
      <div class="panel cta-band">
        <div class="stack">
          <h2>Not sure it fits?</h2>
          <p class="lead">Start with the free check-up. We will tell you what you need and what you can skip.</p>
        </div>
        <div class="row">
          <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog">Book a check-up</a>
          <a class="btn btn--secondary btn--lg" href="tel:+18555550142">1-855-555-0142</a>
        </div>
      </div>
    </div>
  </section>
</Base>
