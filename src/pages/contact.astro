---
// CONTACT. Sections in page order; each is one component in src/components/contact/.
import Base from '../layouts/Base.astro';
import { PAGES } from '../lib/site';
import Message from '../components/contact/Message.astro';
import Support from '../components/contact/Support.astro';
---

<Base
  title={PAGES.contact.title}
  description={PAGES.contact.description}
  page="contact"
  path="/contact"
  type="ContactPage"
>
  <Message />
  <Support />
  <Fragment slot="scripts">
    <script>
      import '../scripts/contact.js';
    </script>
  </Fragment>
</Base>
