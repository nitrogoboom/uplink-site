---
// HOME. Sections in page order; each is one component in src/components/home/.
// The business block (JSON-LD) is the one every other page's JSON-LD points at by its @id.
import Base from '../layouts/Base.astro';
import { HERO, jsonLd, pageMeta } from '../lib/site';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Grow from '../components/home/Grow.astro';
import Work from '../components/home/Work.astro';
import Reviews from '../components/home/Reviews.astro';
import Proof from '../components/home/Proof.astro';
import { phone, email, office } from '../lib/footer';
import Words from '../components/Words.astro';
import { copy } from '../lib/copy';
import type { HomeWords } from '../lib/copy-schema';
const { cloud, grow, business: about } = await copy('home');
const meta = await pageMeta('home');

const site = Astro.site!.href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}#business`,
  name: 'Uplink Technology',
  url: site,
  description: about,
  telephone: `+${phone.display}`,
  email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: office.street,
    addressLocality: office.city,
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '19:00',
    },
  ],
  areaServed: 'Ontario',
  knowsLanguage: ['en', 'fr'],
};
---

<Base title={meta.title} description={meta.description} page="home" path="/">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd(business)} />
    <link rel="preload" href={HERO.phone} as="fetch" crossorigin media={HERO.media.phone} />
    <link rel="preload" href={HERO.phoneFlows} as="fetch" crossorigin media={HERO.media.phone} />
    <link rel="preload" href={HERO.tablet} as="fetch" crossorigin media={HERO.media.tablet} />
    <link rel="preload" href={HERO.full} as="fetch" crossorigin media={HERO.media.full} />
  </Fragment>
  <Hero />
  <Services />
  <Grow />
  <Work />
  <Reviews><Proof /></Reviews>
  <Fragment slot="scripts">
    <Words id="words-page" words={{ cloud, grow: { team: grow.team, play: grow.play } } satisfies HomeWords} />
    <script>
      import '../scripts/home.js';
    </script>
  </Fragment>
</Base>
