---
// HOME. Sections in page order; each is one component in src/components/home/.
// The business block (JSON-LD) is the one every other page's JSON-LD points at by its @id.
import Base from '../layouts/Base.astro';
import Hero, { HERO } from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Grow from '../components/home/Grow.astro';
import Process from '../components/home/Process.astro';
import Proof from '../components/home/Proof.astro';
import '../styles/late.css';   // last: the desktop layout block wins a tie against the sections' CSS

const site = Astro.site!.href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}#business`,
  name: 'Uplink Technology',
  url: site,
  description: 'Managed IT for Ontario businesses: help desk, security, cloud, networks and phones, run by one in-house team.',
  telephone: '+1-855-555-0142',
  email: 'hello@uplinkit.ca',
  address: { '@type': 'PostalAddress', streetAddress: '100 King St W, Suite 4200', addressLocality: 'Toronto', addressRegion: 'ON', addressCountry: 'CA' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:00', closes: '19:00' }],
  areaServed: 'Ontario',
  knowsLanguage: ['en', 'fr'],
};
---
<Base title="Uplink Technology · Managed IT for Ontario businesses"
      description="Outsourced IT for Ontario businesses: help desk, security, cloud, networks and phones, run by one in-house team."
      page="home" path="/">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(business, null, 1).replace(/<\//g, '<\\/')} />
    <link rel="preload" href="/assets/img/office-compact.svg" as="image" media="(max-width: 599px)" fetchpriority="high">
    <link rel="preload" href={HERO} as="fetch" crossorigin media="(min-width: 600px)">
  </Fragment>
  <Hero />
  <Services />
  <Grow />
  <Process />
  <Proof />
</Base>
<script>
  import '../scripts/home.js';
</script>
