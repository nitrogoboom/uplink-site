---
// HOME. Sections in page order; each is one component in src/components/home/.
// The business block (JSON-LD) is the one every other page's JSON-LD points at by its @id.
import Base from '../layouts/Base.astro';
import { HERO, PAGES } from '../lib/site';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Grow from '../components/home/Grow.astro';
import Work from '../components/home/Work.astro';
import Proof from '../components/home/Proof.astro';

const site = Astro.site!.href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}#business`,
  name: 'Uplink Technology',
  url: site,
  description: 'Managed IT for Ontario businesses: help desk, security, cloud, networks and phones, run by one in-house team.',
  telephone: '+1-855-555-0142',
  email: 'hello@uplinkit.ca',
  address: { '@type': 'PostalAddress', streetAddress: '100 King St W, Suite 4200', addressLocality: 'Toronto', addressRegion: 'ON', addressCountry: 'CA' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:00', closes: '19:00' }],
  areaServed: 'Ontario',
  knowsLanguage: ['en', 'fr'],
};
---
<Base title={PAGES.home.title} description={PAGES.home.description}
      page="home" path="/">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(business, null, 1).replace(/<\//g, '<\\/')} />
    <link rel="preload" href="/assets/img/office-compact.svg" as="image" media={`${HERO.media.phone} and (prefers-reduced-motion: reduce)`} fetchpriority="high">
    <link rel="preload" href={HERO.phone} as="fetch" crossorigin media={`${HERO.media.phone} and (prefers-reduced-motion: no-preference)`}>
    <link rel="preload" href={HERO.phoneFlows} as="fetch" crossorigin media={`${HERO.media.phone} and (prefers-reduced-motion: no-preference)`}>
    <link rel="preload" href={HERO.tablet} as="fetch" crossorigin media={HERO.media.tablet}>
    <link rel="preload" href={HERO.full} as="fetch" crossorigin media={HERO.media.full}>
  </Fragment>
  <Hero />
  <Services />
  <Grow />
  <Work />
  <Proof />
</Base>
<script>
  import '../scripts/home.js';
</script>
