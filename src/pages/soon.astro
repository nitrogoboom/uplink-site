---
// COMING SOON: one page for every link that has no page yet. soon.js reads the #address and fills in which
// page it is. No canonical or Open Graph (no `path`); kept out of search results. Styles: shared (.page-intro).
import Base from '../layouts/Base.astro';
---
<Base title="Coming soon · Uplink Technology"
      description="This part of the Uplink Technology site is not built yet."
      page="soon" robots="noindex, follow">
  <section class="page-intro" aria-labelledby="soon-title">
    <div class="container">
      <p class="eyebrow">Placeholder</p>
      <h1 id="soon-title"><span data-soon-name>This page</span> is not built yet</h1>
      <p class="lead">This prototype links here for pages that come later, such as the client portal, legal pages and the blog.</p>
      <div class="row">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--secondary" href="/contact">Contact</a>
      </div>
    </div>
  </section>
  <Fragment slot="scripts">
    <script>
      import '../scripts/soon.js';
    </script>
  </Fragment>
</Base>
