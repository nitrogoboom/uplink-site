---
// The shared page: <head>, header, footer, the pop-ups and the toast region. Every page uses it. Its props, and how a
// page gives its script's words (<Words> inside <Fragment slot="scripts">): src/README.md, "Pages". Anything else a
// page needs in its <head> (preloads, JSON-LD) goes in <Fragment slot="head">.
// the shared CSS: Astro writes it inside every page (astro.config.mjs, inlineStylesheets)
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import BookDialog from '../components/BookDialog.astro';
import SettingsDialog from '../components/SettingsDialog.astro';
import { breadcrumbs, businessNode, businessRef, jsonLd } from '../lib/site';
import { footer as contact } from '../lib/footer';
import Words from '../components/Words.astro';
import { copy } from '../lib/copy';
import { sha256 } from '../lib/csp';
import themeInit from '../scripts/theme-init.js?raw';
import { LOCALES, langTag, linker } from '../lib/i18n';

export type Page =
  'home' | 'services' | 'work' | 'about' | 'contact' | 'privacy' | 'accessibility' | 'soon' | 'notfound';
interface Props {
  title: string;
  description: string;
  page: Page;
  path?: string; // gives a canonical and Open Graph tags; leave it out for pages that carry neither (soon, 404)
  robots?: string;
  ogType?: 'website' | 'article';
  // writes JSON-LD for the page and its breadcrumb, pointing at Home's business block by @id
  type?: 'FAQPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage';
  ldPage?: Record<string, unknown>; // more fields for the page's JSON-LD node (e.g. a FAQPage's mainEntity)
  ldGraph?: object[]; // more nodes for the page's JSON-LD graph (e.g. the Services listed)
  // false: no footer (the 404). <body> gets .no-footer, so <main> keeps the room under the page for the phone tab bar
  // (bottom-nav.css). With the footer comes a one-line contact block for paper (.print-contact, print.css).
  footer?: boolean;
}
const {
  title,
  description,
  page,
  path,
  robots,
  ogType = 'website',
  type,
  ldPage = {},
  ldGraph = [],
  footer = true,
} = Astro.props;
const lang = langTag(Astro.currentLocale);
const at = (p: string, locale = Astro.currentLocale) => new URL(linker(locale)(p), Astro.site).href;
const canonical = path === undefined ? null : at(path);
// the same page in each language, for search engines (only once there is more than one)
const alternates =
  path === undefined || LOCALES.length < 2 ? [] : LOCALES.map((l) => ({ lang: langTag(l), href: at(path, l) }));
const ogImage = new URL('/assets/img/og.png', Astro.site).href;
const business = businessRef(Astro.site!);
const name = title.split(' · ')[0];
const jsonld = type &&
  canonical && {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': type,
        '@id': canonical,
        url: canonical,
        name,
        description,
        inLanguage: lang,
        publisher: business,
        ...(type === 'AboutPage' ? { about: business } : {}),
        ...ldPage,
      },
      breadcrumbs([
        [(await copy('ui', Astro.currentLocale)).pages.home, at('/')],
        [name, canonical],
      ]),
      await businessNode(Astro.site!, Astro.currentLocale),
      ...ldGraph,
    ],
  };
const ui = await copy('ui', Astro.currentLocale);
Astro.csp?.insertScriptHash(sha256(themeInit));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <Fragment>
      <meta property="og:type" content={ogType} />
      <meta property="og:site_name" content={ui.site.name} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonical} />
      <meta property="og:locale" content={lang.replace('-', '_')} />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={ui.site.ogImageAlt} />
      <meta name="twitter:card" content="summary_large_image" />
    </Fragment>}
    <meta name="theme-color" content="#0E1A27" />
    {/* Before the page paints: html.js, the theme (Settings: System, Light or Dark) and Reduce motion (core.js keeps
        both up to date; html[data-motion] is how the CSS sees it, postcss.config.mjs). uplink.theme holds the
        visitor's choice; anything else, or no storage, follows the device. Reduce motion is "reduce" if the visitor
        turned it on (uplink.motion), or their device asks for less motion and they haven't turned it off; "full" if
        they turned it off. The light colours are in theme-light.css; #E8EFF7 is the light page colour, for the
        browser's own bar. The script is src/scripts/theme-init.js, written into the page as it is (so it carries no
        comments but the one type); its hash goes in the page's CSP, since Astro hashes only the scripts it bundles. */}
    <script is:inline set:html={themeInit} />
    {/* The fonts (astro.config.mjs, "fonts"). Preload the faces a page's first screen shows at every size, the page
        title (Condensed 700 italic) and body text (Barlow 400) first: four on every page, and Condensed 600 too on
        Home (elsewhere a phone's first screen has none of it, so it starts at the first layout). A face the head
        doesn't name counts as a chained request (PageSpeed, "Network dependency tree"); at about 10 KB a face, naming
        them costs the title and body faces little. Their fallbacks take the same room, so nothing moves when they
        arrive. */}
    <Font
      cssVariable="--font-barlow-condensed"
      preload={[
        { weight: 700, style: 'italic' },
        { weight: 700, style: 'normal' },
        ...(page === 'home' ? [{ weight: 600, style: 'normal' }] : []),
      ]}
    />
    <Font
      cssVariable="--font-barlow"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 600, style: 'normal' },
      ]}
    />
    <slot name="head" />
    {jsonld && <script is:inline type="application/ld+json" set:html={jsonLd(jsonld)} />}
  </head>
  <body data-page={page} class={footer ? undefined : 'no-footer'}>
    <a class="skip-link" href="#main">{ui.skipLink}</a>
    <Header current={page} />

    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && <Footer />}
    {footer && <p class="print-contact">
      {ui.site.name} · {contact.phone.display} · {contact.email} · {contact.office.street}, {contact.office.city}
    </p>}

    <BottomNav current={page} />

    <BookDialog />

    <SettingsDialog />

    <div class="toasts" aria-live="polite"></div>

    <Words id="words-ui" words={{ toast: ui.toast, emailError: ui.form.email.error }} />
    <script>
      import '../scripts/site.js';
    </script>
    <slot name="scripts" />
    {/* Cloudflare Web Analytics, installed by hand (its "manual setup") so Cloudflare never rewrites a page to add it:
        a rewrite slowed the first paint and dropped the page's ETag (docs/ops.md, "Domain"). It loads after the page
        is drawn, sets no cookies or storage, and reports load times; the CSP allows its two hosts (astro.config.mjs).
        Built pages only, so `npm run dev` sends nothing. The token is public: it names the jodesign.ca site. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "6169396cdfc244dd9a084dbf544fbafe"}'
      />
    )}
  </body>
</html>
