---
// The words a page script shows (toasts, button names), from src/data/copy/en/*.yaml, as JSON for the script to read
// with words() from core.js. A data block, not a script: the browser runs nothing from it, so the CSP needs no hash
// (scripts/headers.mjs hashes only the inline scripts that run). It sits outside <main>, so the Markdown copy skips it.
//   <Words id="words-page" words={{ … } satisfies HomeWords} />
import { wordsJson } from '../lib/copy';
interface Props {
  id: 'words-ui' | 'words-page';
  words: unknown;
}
const { id, words } = Astro.props;
---

<script is:inline type="application/json" id={id} set:html={wordsJson(words)} />
