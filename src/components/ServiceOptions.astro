---
// The service <option>s for a "What do you need?" list, from the collection. The contact form and the booking
// pop-up each wrap these in their own first and last options.
import { getServices } from '../lib/site';
const services = await getServices();
---

{services.map(({ data: s }) =>
  s.optionLabel ? <option value={s.title}>{s.optionLabel}</option> : <option>{s.title}</option>,
)}
