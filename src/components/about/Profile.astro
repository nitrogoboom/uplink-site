---
// ABOUT · 1. Who we are (first screen): intro text and the HQ building card. The text comes first in the HTML, so
// a screen reader hears the heading before the card; the grid areas (profile.css) put the card on the left on screen.
// Styles: profile.css (industry chips included), plus .facts (src/styles/facts.css). Desktop layout: at the end of its CSS.
import Drawing from '../Drawing.astro';
import './profile.css';
import { copy } from '../../lib/copy';
const t = (await copy('about')).profile;
const { site } = await copy('ui');
---

<section class="page-intro fold fold-always" id="profile" aria-labelledby="about-title">
  <div class="container">
    <div class="profile">
      <div class="profile-text">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 id="about-title">{t.title}</h1>
        <div class="prose">
          {t.body.map((p) => <p>{p}</p>)}
        </div>
        <ul class="stats">
          {t.stats.map((s) => <li class="stat panel">
            <span class="label">{s.label}</span><span class="stat-val">{s.value}</span>
          </li>)}
        </ul>
      </div>
      <aside class="profile-card panel" aria-label={t.card.label}>
        <div class="profile-art well">
          <Drawing
            src="/assets/img/hq.svg"
            sources={[{ media: '(width < 100em)', srcset: '/assets/img/hq-compact.svg' }]}
            fetchpriority="high"
            loading="lazy"
            alt={t.card.alt}
            width="640"
            height="480"
          />
          <span class="chip chip--accent">{t.card.since}</span>
        </div>
        <div class="stack-2">
          <span class="brand-name">{site.name}</span>
          <p class="muted">{t.card.line}</p>
        </div>
        <div class="stack-2">
          <span class="label">{t.card.knownFor}</span>
          <ul class="industries">
            {t.card.chips.map((c) => <li><span class="chip">{c}</span></li>)}
          </ul>
        </div>
        <dl class="facts">
          {t.card.facts.map((f) => <div>
            <dt>{f.term}</dt>
            <dd>{f.value}</dd>
          </div>)}
        </dl>
      </aside>
    </div>
  </div>
</section>
