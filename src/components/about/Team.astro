---
// ABOUT · 3. Team: one card per person from src/data/team.json, then the call-to-action band. Styles: team.css.
// The hidden ", " between name and role: a screen reader (and the Markdown copy) says "Maya Roy, Founder and CEO".
import { getCollection } from 'astro:content';
import { byOrder } from '../../content.config';
import './team.css';
import { copy } from '../../lib/copy';
const team = (await getCollection('team')).sort(byOrder);
const t = (await copy('about')).team;
const ui = await copy('ui');
---

<section class="section fold" id="team" aria-labelledby="team-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="team-title">{t.title}</h2>
    </div>
    <ul class="team">
      {team.map(({ data: t }) => <li class="person panel">
        <span class="avatar" aria-hidden="true">{t.initials}</span
        ><span class="stack-2"
          ><span class="person-name">{t.name}</span><span class="sr-only">, </span
          ><span class="small muted">{t.role}</span></span
        >
      </li>)}
    </ul>
    <div class="panel cta-band fold-foot" id="start">
      <div class="stack">
        <h2 id="start-title">{t.cta.title}</h2>
        <p class="lead">{t.cta.lead}</p>
      </div>
      <div class="row">
        <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog">{ui.cta.book}</a>
        <a class="btn btn--secondary btn--lg" href="/soon#careers">{t.cta.join}</a>
      </div>
    </div>
  </div>
</section>
