---
// ABOUT · 2. How we work: four numbered steps.
// Styles: shared (.steps in src/styles/shared-blocks.css).
import { copy } from '../../lib/copy';
const t = (await copy('about')).process;
---

<section class="section section--band" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="process-title">{t.title}</h2>
    </div>
    <ol class="steps">
      {t.steps.map((s, i) => <li class="step panel">
        <span class="step-n" aria-hidden="true">{i + 1}</span>
        <h3>{s.title}</h3>
        <p class="muted">{s.text}</p>
      </li>)}
    </ol>
  </div>
</section>
