---
// SHARED · Keyboard shortcuts pop-up (every page)
// Opened with ? or the footer's "Keyboard shortcuts" button. Styles: src/styles/dialogs.css.
import Icon from './Icon.astro';
---
<dialog class="dialog" id="shortcuts-dialog" aria-labelledby="sc-title">
  <div class="dlg-head">
    <h2 id="sc-title">Keyboard shortcuts</h2>
    <button class="hbtn" type="button" data-close><span class="kbd kbd-hint" aria-hidden="true">Esc</span><Icon name="close" /><span class="sr-only">Close</span></button>
  </div>
  <div class="dlg-body">
    <label class="switch" for="sc-toggle">
      <span class="stack-2"><strong>Single-key shortcuts</strong><span class="small muted">Turn off if they clash with a screen reader or voice control.</span></span>
      <input id="sc-toggle" type="checkbox" role="switch" checked>
    </label>
    <section class="keys-group" aria-labelledby="sc-popups">
      <h3 class="label" id="sc-popups">Pop-ups</h3>
      <ul class="keys-list">
        <li><span>Close</span><span class="keys"><span class="kbd">Esc</span></span></li>
        <li><span>Show this list</span><span class="keys"><span class="kbd">?</span></span></li>
      </ul>
    </section>
    <p class="small muted">Shortcuts pause while you type or while a pop-up is open.</p>
  </div>
</dialog>
