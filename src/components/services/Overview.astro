---
// SERVICES · 1. Overview (first screen): what managed IT with Uplink is, then one card per service from the
// collection, each linking to the service's own page. Styles: overview.css. Desktop layout: at the end of its CSS.
import { getCollection } from 'astro:content';
import './overview.css';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<section class="page-intro" id="overview" aria-labelledby="svc-page-title">
  <div class="container svc-overview">
    <div class="svc-overview-head">
      <p class="eyebrow">Services</p>
      <h1 id="svc-page-title">Managed IT, one team</h1>
      <p class="lead">We run the technology behind your office: help desk, security, cloud, network and phones. We look first, then quote.</p>
      <div class="row"><a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog">Book a check-up</a></div>
    </div>
    <ul class="svc-grid" aria-label="Services">
      {services.map(({ id, data: s }) => (
        <li><a class="card" href={`/services/${id}`}>
          <span class="card-media well"><img src={`/assets/img/${s.image}-card.svg`} alt="" width="640" height="480" loading="lazy"><span class="chip">{s.chip}</span></span>
          <span class="card-body"><span class="card-title">{s.title}</span><span class="muted small">{s.card}</span></span>
        </a></li>
      ))}
    </ul>
  </div>
</section>
