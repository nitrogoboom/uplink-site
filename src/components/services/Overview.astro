---
// SERVICES · 1. Overview (first screen): what managed IT with Uplink is, then one card per service from the
// collection: its chip, then its title as an h2 holding the link to the service's own page, the link covering the
// card (.card-link in surfaces.css; review M3, M10). Styles: overview.css. Desktop layout: at the end of its CSS.
import Drawing from '../Drawing.astro';
import './overview.css';
import { getServices } from '../../lib/site';
import { fit } from '../../lib/fit';
import { copy } from '../../lib/copy';
const services = await getServices();
const t = (await copy('services')).overview;
const ui = await copy('ui');
---

<section class="page-intro" id="overview" aria-labelledby="svc-page-title">
  <div class="container svc-overview">
    <div class="svc-overview-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="svc-page-title">{t.title}</h1>
      <p class="lead">{t.lead}</p>
      <div class="row">
        <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog">{ui.cta.book}</a>
      </div>
    </div>
    <ul class="svc-grid" aria-label={t.list}>
      {services.map(({ id, data: s }) => <li>
        <div class="card">
          <span class="card-media well"
            ><Drawing src={`/assets/img/${s.image}-card.svg`} alt="" width="640" height="480" loading="lazy" /><span
              class="chip"
              >{s.chip}</span
            ></span
          >
          <div class="card-body">
            <h2 class:list={['card-title', fit(s.title)]}>
              <a class="card-link" href={`/services/${id}`}>{s.title}</a>
            </h2>
            <span class="muted small">{s.card}</span>
          </div>
        </div>
      </li>)}
    </ul>
  </div>
</section>
