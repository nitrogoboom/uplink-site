---
// SERVICES · 3. Questions: the FAQ from src/data/faq.json, then the call-to-action band.
// Styles: shared (.faq, .cta-band in src/styles/shared-blocks.css).
import { getCollection } from 'astro:content';
import { byOrder } from '../../content.config';
import Icon from '../Icon.astro';
import { phone } from '../../lib/footer';
import { copy } from '../../lib/copy';
const faq = (await getCollection('faq')).sort(byOrder);
const t = (await copy('services')).faq;
const ui = await copy('ui');
---

<section class="section fold fold-always" id="faq" aria-labelledby="faq-title">
  <div class="container split">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="faq-title">{t.title}</h2>
    </div>
    <div class="faq">
      {faq.map(({ data: f }) => <details>
        <summary>{f.q}<Icon name="plus" /></summary>
        <div><p>{f.a}</p></div>
      </details>)}
    </div>
    <div class="panel cta-band fold-foot" id="start">
      <div class="stack">
        <h2 id="start-title">{t.cta.title}</h2>
        <p class="lead">{t.cta.lead}</p>
      </div>
      <div class="row">
        <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog">{ui.cta.book}</a>
        <a class="btn btn--secondary btn--lg" href={phone.href}>{phone.display}</a>
      </div>
    </div>
  </div>
</section>
