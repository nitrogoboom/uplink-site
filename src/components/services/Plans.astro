---
// SERVICES · 2. Plans: the three-plan comparison table, from src/data/plans.json. A cell is true (included),
// false (not included) or a short text. Styles: plans.css.
import Icon from '../Icon.astro';
import plans from '../../data/plans.json';
import './plans.css';
---
<section class="section section--band fold" id="plans" aria-labelledby="plans-title">
  <div class="container split">
    <div class="section-head">
      <p class="eyebrow">Plans</p>
      <h2 id="plans-title">Three plans, one team</h2>
      <p class="lead">Every plan includes the help desk. Pick the level of protection and planning you need, then we quote after the free check-up.</p>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Plan comparison table, scrolls sideways">
      <table class="plans">
        <caption class="sr-only">What each plan includes</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            {plans.columns.map((c) => <th scope="col" class:list={{ 'col-hi': c.highlight }}>{c.name}<small>{c.sub}</small></th>)}
          </tr>
        </thead>
        <tbody>
          {plans.rows.map((r) => (
            <tr><th scope="row">{r.feature}</th>{r.cells.map((cell, i) => (
              <td class:list={{ 'col-hi': plans.columns[i].highlight }}>{
                cell === true ? <span class="yes"><Icon name="check" /><span class="sr-only">Included</span></span>
                : cell === false ? <span class="no"><Icon name="minus" /><span class="sr-only">Not included</span></span>
                : cell}</td>
            ))}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
