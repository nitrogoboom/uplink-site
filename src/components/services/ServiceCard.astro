---
// One service, in full: the top of a service's own page (/services/<slug>). The content comes from
// src/content/services/<slug>.json.
//   service   the collection entry
//   n, total  its place ("Service 03 of 07")
//   on        shown (kept from the picker's styles in service-card.css)
//   first     the drawing loads eagerly
//   heading   h1 on the service's own page. "What's included" and "Best for" are one level down.
import type { CollectionEntry } from 'astro:content';
import './service-card.css';
interface Props { service: CollectionEntry<'services'>; n: number; total: number; on?: boolean; first?: boolean; heading?: 'h1' | 'h2' }
const { service, n, total, on = false, first = false, heading: Heading = 'h2' } = Astro.props;
const Sub = Heading === 'h1' ? 'h2' : 'h3';
const { id, data: s } = service;
const two = (k: number) => String(k).padStart(2, '0');
---
<article class:list={['svc', { 'is-on': on }]} id={id} aria-labelledby={`svc-${id}`}>
  <div class="picker-head">
    <span class="chip chip--sky">{s.chip}</span>
    <Heading id={`svc-${id}`}>{s.title}</Heading>
    <p class="lead">{s.lead}</p>
  </div>
  <div class="picker-prev panel">
    <div class="picker-art">
      <div class="tags"><span class="chip">Service {two(n)} of {two(total)}</span><span class="chip">{s.tag}</span></div>
      <picture>
        <source media="(width < 75em)" srcset={`/assets/img/${s.image}-compact.svg`}>
        <img src={`/assets/img/${s.image}.svg`} fetchpriority={first ? 'high' : undefined} loading={first ? undefined : 'lazy'} alt={s.alt} width="640" height="480">
      </picture>
    </div>
  </div>
  <div class="picker-detail">
    <Sub class="label">What's included</Sub>
    <ul class="feat-list">
      {s.features.map((f, i) => (
        <li class="feat"><span class="icon-tile" aria-hidden="true">{i + 1}</span><span><span class="feat-t">{f.title}</span><span class="feat-d">{f.detail}</span></span></li>
      ))}
    </ul>
    <div class="row"><Sub class="label">Best for</Sub><p>{s.bestFor}</p></div>
  </div>
</article>
