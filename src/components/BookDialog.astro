---
// SHARED · "Book your free check-up" pop-up (every page)
// Opened by any link with data-open="book-dialog". Mockup: sends nothing.
// Styles: src/styles/dialogs.css, src/styles/forms.css.
import ServiceOptions from './ServiceOptions.astro';
import Icon from './Icon.astro';
import { copy } from '../lib/copy';
const { book: t, form, dialog } = await copy('ui');
---

<dialog class="dialog" id="book-dialog" aria-labelledby="book-title">
  <form data-validate="book" method="dialog">
    <div class="dlg-head">
      <h2 id="book-title">{t.title}</h2>
      <button class="hbtn" type="button" data-close aria-keyshortcuts="Escape">
        <span class="kbd kbd-hint" aria-hidden="true">{dialog.key}</span
        ><Icon name="close" /><span class="sr-only">{dialog.close}</span>
      </button>
    </div>
    <div class="dlg-body">
      <p class="muted">{t.lead}</p>
      <p class="small muted">{form.required}</p>
      <div class="form-grid">
        <div class="field">
          <label for="book-name">{form.name.label}</label>
          <input
            class="input"
            id="book-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            pattern=".*\S.*"
            title={form.name.title}
          />
          <span class="field-error" id="book-name-err">{t.nameError}</span>
        </div>
        <div class="field">
          <label for="book-email">{form.email.label}</label>
          <input
            class="input"
            id="book-email"
            name="email"
            type="email"
            pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
            title={form.email.title}
            autocomplete="email"
            placeholder={form.email.placeholder}
            required
          />
          <span class="field-error" id="book-email-err">{form.email.error}</span>
        </div>
        <div class="field">
          <label for="book-company">{form.company} <span class="opt">{form.optional}</span></label>
          <input class="input" id="book-company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="book-size">{t.size.label}</label>
          <select class="input" id="book-size" name="size" required>
            <option value="">{form.choose}</option>
            {t.size.options.map((o) => <option>{o}</option>)}
          </select>
          <span class="field-error" id="book-size-err">{t.size.error}</span>
        </div>
        <div class="field span-2">
          <label for="book-service">{t.service.label}</label>
          <select class="input" id="book-service" name="service">
            <option>{t.service.unsure}</option>
            <ServiceOptions />
          </select>
        </div>
      </div>
      <p class="small muted">{form.prototype}</p>
    </div>
    <div class="dlg-actions">
      <button class="btn btn--secondary" type="button" data-close>{t.cancel}</button>
      <button class="btn btn--primary" type="submit">{t.submit}</button>
    </div>
  </form>
  <div class="toasts" aria-live="polite"></div>
</dialog>
