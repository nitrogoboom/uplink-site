---
// WORK · 1. Projects (first screen): intro, filter buttons (work.js) and one card per project from the
// collection, each linking to the project's own page. Styles: projects.css. Desktop layout: at the end of its CSS.
import { getCollection } from 'astro:content';
import './projects.css';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const tags = ['Build', 'Protect', 'Plan'] as const;
const count = (t: string) => projects.filter((p) => p.data.tag === t).length;
---
<section class="page-intro fold" id="projects" aria-labelledby="work-title">
  <div class="container work-layout">
    <div class="work-side">
      <p class="eyebrow">Our work</p>
      <h1 id="work-title">Setups we built and still run</h1>
      <p class="lead">Every project here is a client we still look after today. Open one to see what we found, what we did and how it turned out.</p>
      <ul class="filters" aria-label="Filter projects">
        <li><button class="filter" type="button" data-filter="all" aria-pressed="true">All<span class="count">{projects.length}</span></button></li>
        {tags.map((t) => <li><button class="filter" type="button" data-filter={t.toLowerCase()} aria-pressed="false">{t}<span class="count">{count(t)}</span></button></li>)}
      </ul>
      <p class="sr-only" aria-live="polite" data-work-live></p>
    </div>
    <div class="work-main">
    <ul class="work-grid" data-work-grid>
      {projects.map(({ id, data: p }, i) => (
        <li data-tags={p.tag.toLowerCase()}><a class="card" href={`/work/${id}`}>
          <span class="card-media well"><img src={`/assets/img/${p.image}-card.svg`} alt="" width={p.image === 'office' ? 1200 : 640} height={p.image === 'office' ? 800 : 480} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'}><span class="chip">{p.tag}</span></span>
          <span class="card-body"><span class="card-title">{p.name}</span><span class="muted small">{p.clientShort}</span></span>
        </a></li>
      ))}
    </ul>
    <p class="muted empty-note" data-work-empty hidden>No projects match this filter yet.</p>
    </div>
  </div>
</section>
