---
// WORK · 3. Project pop-up: an empty frame that work.js fills from Details.
// Styles: details.css and src/styles/dialogs.css.
---
<dialog class="dialog dialog--wide" id="case-dialog" aria-labelledby="case-title">
  <div class="dlg-head">
    <h2 id="case-title" data-case-bind="name">Office move in a weekend</h2>
    <button class="hbtn" type="button" data-close><span class="kbd kbd-hint" aria-hidden="true">Esc</span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg><span class="sr-only">Close</span></button>
  </div>
  <div class="dlg-body">
    <div class="case">
      <div class="case-fig">
        <div class="case-img well"><picture><source media="(max-width: 1599px)" srcset="/assets/img/office-compact.svg" data-case-src><img data-case-img loading="lazy" src="/assets/img/office.svg" alt="Floor plan of the new office with desks, server rack and Wi-Fi" width="1200" height="800"></picture></div>
      </div>
      <div class="stack">
        <span class="chip chip--sky" data-case-bind="tag">Build</span>
        <p class="muted" data-case-bind="story">A growing firm moved floors on a Friday.</p>
        <dl class="facts">
          <div><dt>Client</dt><dd data-case-bind="client">Professional services firm, 40 staff</dd></div>
          <div><dt>Services</dt><dd data-case-bind="services">Networks &amp; Wi-Fi, help desk</dd></div>
          <div><dt>Result</dt><dd class="accent" data-case-bind="result">Staff logged in Monday like nothing happened</dd></div>
        </dl>
        <a class="link-arrow" href="/soon#case-studies">Read the full case study<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </div>
  </div>
  <div class="dlg-actions">
    <div class="case-nav">
      <button class="btn btn--secondary" type="button" data-case-step="-1"><span class="kbd kbd-hint" aria-hidden="true">←</span>Previous</button>
      <span class="pos" data-case-pos aria-live="polite">1 of 6</span>
      <button class="btn btn--secondary" type="button" data-case-step="1">Next<span class="kbd kbd-hint" aria-hidden="true">→</span></button>
    </div>
    <button class="btn btn--primary" type="button" data-close>Done</button>
  </div>
</dialog>
