---
// WORK · 3. Project pop-up: a frame that work.js fills from Details. It starts out holding the first project.
// Styles: details.css and src/styles/dialogs.css.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const { id, data: p } = projects[0];
---
<dialog class="dialog dialog--wide" id="case-dialog" aria-labelledby="case-title">
  <div class="dlg-head">
    <h2 id="case-title" data-case-bind="name">{p.name}</h2>
    <button class="hbtn" type="button" data-close><span class="kbd kbd-hint" aria-hidden="true">Esc</span><Icon name="close" /><span class="sr-only">Close</span></button>
  </div>
  <div class="dlg-body">
    <div class="case">
      <div class="case-fig">
        <div class="case-img well"><picture><source media="(max-width: 1599px)" srcset={`/assets/img/${p.image}-compact.svg`} data-case-src><img data-case-img loading="lazy" src={`/assets/img/${p.image}.svg`} alt={p.alt} width="1200" height="800"></picture></div>
      </div>
      <div class="stack">
        <span class="chip chip--sky" data-case-bind="tag">{p.tag}</span>
        <p class="muted" data-case-bind="story">{p.story}</p>
        <dl class="facts">
          <div><dt>Client</dt><dd data-case-bind="client">{p.client}</dd></div>
          <div><dt>Services</dt><dd data-case-bind="services">{p.services}</dd></div>
          <div><dt>Result</dt><dd class="accent" data-case-bind="result">{p.result}</dd></div>
        </dl>
        <a class="link-arrow" href={`/work/${id}`} data-case-link>Open this project's page<Icon name="arrow" /></a>
      </div>
    </div>
  </div>
  <div class="dlg-actions">
    <div class="case-nav">
      <button class="btn btn--secondary" type="button" data-case-step="-1"><span class="kbd kbd-hint" aria-hidden="true">←</span>Previous</button>
      <span class="pos" data-case-pos aria-live="polite">1 of {projects.length}</span>
      <button class="btn btn--secondary" type="button" data-case-step="1">Next<span class="kbd kbd-hint" aria-hidden="true">→</span></button>
    </div>
    <button class="btn btn--primary" type="button" data-close>Done</button>
  </div>
</dialog>
