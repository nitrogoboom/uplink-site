---
// WORK · 2. Project details: the full story of every project (ProjectCase), in the HTML. With script on, this
// list is hidden and work.js copies one project at a time into CasePopup. Styles: details.css.
import { getCollection } from 'astro:content';
import ProjectCase from './ProjectCase.astro';
import './details.css';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<section class="section cases-list" id="details" aria-labelledby="details-title">
  <div class="container stack-5">
    <h2 id="details-title">Project details</h2>
    {projects.map((p) => <ProjectCase project={p} />)}
  </div>
</section>
