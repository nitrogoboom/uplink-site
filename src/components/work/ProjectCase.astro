---
// One project in full: the whole of a project's own page (/work/<slug>). Content: src/content/<language>/projects/<slug>.json.
import Drawing from '../Drawing.astro';
import type { CollectionEntry } from 'astro:content';
import { getServices, svgSize } from '../../lib/site';
import { fit } from '../../lib/fit';
import './project-case.css';
import { copy } from '../../lib/copy';
import { linker } from '../../lib/i18n';
const to = linker(Astro.currentLocale);
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { id, data: p } = project;
const all = await getServices(Astro.currentLocale);
const services = p.services.flatMap((slug) => all.filter((s) => s.id === slug)); // each links to the service's own page
const size = svgSize(`${p.image}.svg`);
const t = (await copy('work', Astro.currentLocale)).case;
---

<article class="case-src" id={`case-${id}`} aria-labelledby={`case-${id}-t`}>
  <div class="case-title"><h1 id={`case-${id}-t`} class={fit(p.name)} data-case-field="name">{p.name}</h1></div>
  <div class="case">
    <div class="case-fig">
      <div class="case-img well">
        <Drawing src={`${p.image}.svg`} alt={p.alt} width={size.width} height={size.height} loading="lazy" />
      </div>
    </div>
    <div class="stack">
      <span class="chip chip--sky" data-case-field="tag">{p.tag}</span>
      <p class="muted" data-case-field="story">{p.story}</p>
      <dl class="facts">
        <div>
          <dt>{t.client}</dt>
          <dd data-case-field="client">{p.client}</dd>
        </div>
        <div>
          <dt>{t.services}</dt>
          <dd data-case-field="services">
            {services.map(({ id: sid, data: s }, i) => (
              <>{i > 0 && ', '}<a href={to(`/services/${sid}`)}>{s.title}</a></>
            ))}
          </dd>
        </div>
        <div>
          <dt>{t.timeline}</dt>
          <dd data-case-field="timeline">{p.page.timeline}</dd>
        </div>
        <div>
          <dt>{t.result}</dt>
          <dd class="accent" data-case-field="result">{p.result}</dd>
        </div>
      </dl>
    </div>
  </div>
</article>
