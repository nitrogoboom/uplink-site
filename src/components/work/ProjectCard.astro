---
// One project as a card linking to its case study: Home's "Our work", the Work grid and a service page's
// "Where we've done this". The name is a heading holding the link (h2 on /work, h3 under a section's h2), and the
// link covers the whole card (.card-link in surfaces.css), so heading navigation lands on each project and the link
// is named by the name alone (review M3). The client line and the tag chip are read after it as plain text (M10);
// " · " is a short pause (Sep), and a hidden comma keeps the chip apart from the client line. The chip comes last in the markup but shows first: on phones the grid puts it above
// the name, wider screens over the picture's corner. Each part of the client line after the first ("40 staff") keeps
// its words together. Styles: .card and .card--project in src/styles/surfaces.css.
//   project   the collection entry
//   level     the heading level: 2 where the cards sit right under the page's h1, else 3
//   first     the picture loads eagerly (the first card on screen)
import type { CollectionEntry } from 'astro:content';
import Sep from '../Sep.astro';
import { cardSize } from '../../lib/site';
import { fit } from '../../lib/fit';
interface Props {
  project: CollectionEntry<'projects'>;
  level?: 2 | 3;
  first?: boolean;
}
const {
  project: { id, data: p },
  level = 3,
  first = false,
} = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---

<div class="card card--project">
  <span class="card-media well"
    ><img
      src={`/assets/img/${p.image}-card.svg`}
      alt=""
      {...cardSize(p.image)}
      fetchpriority={first ? 'high' : undefined}
      loading={first ? undefined : 'lazy'}
  /></span>
  <span class="card-body"
    ><H class:list={['card-title', fit(p.name)]}><a class="card-link" href={`/work/${id}`}>{p.name}</a></H
    ><span class="card-meta muted small"
      >{p.clientShort
        .split(' · ')
        .map((part, i) => <Fragment
          >{i > 0 ? <Fragment><Sep /><span class="keep">{part}</span></Fragment> : part}</Fragment
        >)}</span
    ></span
  >
  <span class="chip"><span class="sr-only">, </span>{p.tag}</span>
</div>
