---
// SHARED · Settings pop-up (every page), opened by the header's gear or the ? key.
// Keyboard shortcuts: the single-key switch (off if they clash with a screen reader or voice control) and the keys
// there are. More display options go here later (light or dark, English or French). Text size is the browser's own
// zoom and font setting. core.js applies a choice at once and remembers it on this device (localStorage
// uplink.shortcuts). Styles: src/styles/dialogs.css and forms.css (.switch).
import Icon from './Icon.astro';
---
<dialog class="dialog" id="settings-dialog" aria-labelledby="st-title">
  <div class="dlg-head">
    <h2 id="st-title">Settings</h2>
    <button class="hbtn" type="button" data-close aria-keyshortcuts="Escape"><span class="kbd kbd-hint" aria-hidden="true">Esc</span><Icon name="close" /><span class="sr-only">Close (Esc)</span></button>
  </div>
  <div class="dlg-body">
    <section class="keys-group" aria-labelledby="st-keys">
      <h3 class="label" id="st-keys">Keyboard shortcuts</h3>
      <label class="switch" for="sc-toggle">
        <span class="stack-2"><strong id="sc-name">Single-key shortcuts</strong><span class="small muted" id="sc-hint">Turn off if they clash with a screen reader or voice control.</span></span>
        <input id="sc-toggle" type="checkbox" role="switch" aria-labelledby="sc-name" aria-describedby="sc-hint" checked>
      </label>
      <ul class="keys-list">
        <li><span>Open these settings</span><span class="keys"><span class="kbd">?</span></span></li>
      </ul>
      <p class="small muted">Shortcuts pause while you type or while a pop-up is open.</p>
    </section>
  </div>
  <div class="toasts" aria-live="polite"></div>
</dialog>
