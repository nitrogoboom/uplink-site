---
// SHARED · Settings pop-up (every page), opened by the header's gear or the ? key. The gear and the close button are
// invoker commands (commandfor) and a click on the backdrop closes it (closedby="any"), so it works in browsers that
// have them before core.js runs, or if it never loads; core.js takes over when it runs. With script off the gear
// hides (header.css): the one setting needs script.
// Theme: System (the default: follows the device's light or dark setting), Light or Dark, each with its icon
// (screen, sun, moon in icons.ts) beside the word. Native radios in a
// fieldset, so the arrow keys move between them and a screen reader reads the group and each option. Base.astro's head
// script applies the saved choice before the page paints. Keyboard shortcuts: the single-key switch (off if they clash
// with a screen reader or voice control) and the keys there are. More display options go here later (English or
// French). Text size is the browser's own zoom and font setting. core.js applies a choice at once and remembers it on
// this device (localStorage uplink.theme, uplink.shortcuts). Styles: src/styles/dialogs.css and forms.css (.seg,
// .switch).
import Icon from './Icon.astro';
const THEMES = [
  ['system', 'System', 'screen'],
  ['light', 'Light', 'sun'],
  ['dark', 'Dark', 'moon'],
] as const;
---

<dialog class="dialog" id="settings-dialog" aria-labelledby="st-title" closedby="any">
  <div class="dlg-head">
    <h2 id="st-title">Settings</h2>
    <button
      class="hbtn"
      type="button"
      data-close
      commandfor="settings-dialog"
      command="close"
      aria-keyshortcuts="Escape"
    >
      <span class="kbd kbd-hint" aria-hidden="true">Esc</span
      ><Icon name="close" /><span class="sr-only">Close (Esc)</span>
    </button>
  </div>
  <div class="dlg-body">
    <fieldset class="seg-field" aria-describedby="st-theme-note">
      <legend class="label">Theme</legend>
      <div class="seg">
        {THEMES.map(([value, name, icon]) => <label class="seg-opt"
          ><input type="radio" name="theme" value={value} checked={value === 'system'} /><span
            ><Icon name={icon} />{name}</span
          ></label
        >)}
      </div>
      <p class="small muted" id="st-theme-note">System follows your device. Saved on this device.</p>
    </fieldset>
    <section class="keys-group" aria-labelledby="st-keys">
      <h3 class="label" id="st-keys">Keyboard shortcuts</h3>
      <label class="switch" for="sc-toggle">
        <span class="stack-2"
          ><strong id="sc-name">Single-key shortcuts</strong
          ><span class="small muted" id="sc-hint"
            >Turn off if they clash with a screen reader or voice control.</span
          ></span
        >
        <input
          id="sc-toggle"
          type="checkbox"
          role="switch"
          aria-labelledby="sc-name"
          aria-describedby="sc-hint"
          checked
        />
      </label>
      <ul class="keys-list">
        <li>
          <span>Open these settings</span><span class="keys"><span class="kbd">?</span></span>
        </li>
      </ul>
      <p class="small muted">Shortcuts pause while you type or while a pop-up is open.</p>
    </section>
  </div>
  <div class="toasts" aria-live="polite"></div>
</dialog>
