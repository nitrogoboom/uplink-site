---
// SHARED · Settings pop-up (every page; src/README.md, "Shared components"), opened by the header's gear or the ? key.
// The gear and the close button are invoker commands (commandfor) and a click on the backdrop closes it
// (closedby="any"), so it works before core.js runs, or if it never loads. With script off the gear hides (header.css):
// the settings need script. Theme: native radios in a fieldset, so the arrow keys move between them and a screen
// reader reads the group. The shortcuts switch is for when single keys clash with a screen reader or voice control.
// core.js applies a choice at once and keeps it on this device (localStorage uplink.theme, uplink.motion,
// uplink.shortcuts). More display options (English or French) go here later. Styles: dialogs.css, forms.css.
import Icon from './Icon.astro';
import { copy } from '../lib/copy';
const { settings: t, dialog } = await copy('ui');
const THEMES = [
  ['system', t.theme.system, 'screen'],
  ['light', t.theme.light, 'sun'],
  ['dark', t.theme.dark, 'moon'],
] as const;
---

<dialog class="dialog" id="settings-dialog" aria-labelledby="st-title" closedby="any">
  <div class="dlg-head">
    <h2 id="st-title">{t.title}</h2>
    <button
      class="hbtn"
      type="button"
      data-close
      commandfor="settings-dialog"
      command="close"
      aria-keyshortcuts="Escape"
    >
      <span class="kbd kbd-hint" aria-hidden="true">{dialog.key}</span
      ><Icon name="close" /><span class="sr-only">{dialog.close}</span>
    </button>
  </div>
  <div class="dlg-body">
    <fieldset class="seg-field" aria-describedby="st-theme-note">
      <legend class="label">{t.theme.legend}</legend>
      <div class="seg">
        {THEMES.map(([value, name, icon]) => <label class="seg-opt"
          ><input type="radio" name="theme" value={value} checked={value === 'system'} /><span
            ><Icon name={icon} />{name}</span
          ></label
        >)}
      </div>
      <p class="small muted" id="st-theme-note">{t.theme.note}</p>
    </fieldset>
    <section class="keys-group" aria-labelledby="st-motion">
      <h3 class="label" id="st-motion">{t.motion.title}</h3>
      <label class="switch" for="mo-toggle">
        <span class="stack-2"
          ><strong id="mo-name">{t.motion.name}</strong
          ><span class="small muted" id="mo-hint"
            >{t.motion.hint}<span id="mo-device" hidden> {t.motion.device}</span></span
          ></span
        >
        <input id="mo-toggle" type="checkbox" role="switch" aria-labelledby="mo-name" aria-describedby="mo-hint" />
      </label>
    </section>
    <section class="keys-group" aria-labelledby="st-keys">
      <h3 class="label" id="st-keys">{t.keys.title}</h3>
      <label class="switch" for="sc-toggle">
        <span class="stack-2"
          ><strong id="sc-name">{t.keys.name}</strong><span class="small muted" id="sc-hint">{t.keys.hint}</span></span
        >
        <input
          id="sc-toggle"
          type="checkbox"
          role="switch"
          aria-labelledby="sc-name"
          aria-describedby="sc-hint"
          checked
        />
      </label>
      <ul class="keys-list">
        <li>
          <span>{t.keys.open}</span><span class="keys"><span class="kbd">?</span></span>
        </li>
      </ul>
      <p class="small muted">{t.keys.note}</p>
    </section>
  </div>
  <div class="toasts" aria-live="polite"></div>
</dialog>
