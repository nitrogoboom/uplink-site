---
// SHARED · Settings pop-up (every page), opened by the header's gear or the ? key.
// Text size: all the text on every page, up to 200% and back (WCAG 1.4.4, technique G178); the layout keeps its size
// and the sections grow to fit. Keyboard shortcuts: the single-key switch (off if they clash with a screen reader or
// voice control) and the keys there are. More display options go here later (light or dark, English or French).
// core.js applies a choice at once and remembers it on this device (localStorage uplink.text, uplink.shortcuts);
// Base.astro's head sets the text size before the page paints, and takes only these SIZES (keep its list in step).
// Styles: src/styles/dialogs.css and forms.css (.seg, .switch).
import Icon from './Icon.astro';
const SIZES = ['1', '1.25', '1.5', '1.75', '2'];
---
<dialog class="dialog" id="settings-dialog" aria-labelledby="st-title">
  <div class="dlg-head">
    <h2 id="st-title">Settings</h2>
    <button class="hbtn" type="button" data-close aria-keyshortcuts="Escape"><span class="kbd kbd-hint" aria-hidden="true">Esc</span><Icon name="close" /><span class="sr-only">Close (Esc)</span></button>
  </div>
  <div class="dlg-body">
    <fieldset class="seg-field" aria-describedby="st-text-note">
      <legend class="label">Text size</legend>
      <div class="seg">
        {SIZES.map((v) => (
          <label class="seg-opt"><input type="radio" name="text-size" value={v} checked={v === '1'}><span>{Number(v) * 100}%</span></label>
        ))}
      </div>
      <p class="small muted" id="st-text-note">Makes the text bigger on every page. Saved on this device.</p>
    </fieldset>
    <section class="keys-group" aria-labelledby="st-keys">
      <h3 class="label" id="st-keys">Keyboard shortcuts</h3>
      <label class="switch" for="sc-toggle">
        <span class="stack-2"><strong id="sc-name">Single-key shortcuts</strong><span class="small muted" id="sc-hint">Turn off if they clash with a screen reader or voice control.</span></span>
        <input id="sc-toggle" type="checkbox" role="switch" aria-labelledby="sc-name" aria-describedby="sc-hint" checked>
      </label>
      <ul class="keys-list">
        <li><span>Open these settings</span><span class="keys"><span class="kbd">?</span></span></li>
      </ul>
      <p class="small muted">Shortcuts pause while you type or while a pop-up is open.</p>
    </section>
  </div>
  <div class="toasts" aria-live="polite"></div>
</dialog>
