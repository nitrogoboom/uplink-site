---
// HOME · 1. Hero (first screen): headline, "Get started" button, main menu, office drawing and news cards.
// Drawing: one of three cuts (HERO, in src/lib/site.ts), fetched by home.js for the screen it's on: hero-office.svg, or its tablet
// cut hero-office-tablet.svg, both under the moving dashes' own layer in hero-flows.svg, inlined here; phones get the animated
// phone cut office-compact-build.svg with its own dashes (with reduced motion too: it stands still then). All written by
// tools/gen_office.py; don't edit by hand.
// The dashes come in as text (?raw): a plain import would also write a copy to dist/_astro that nothing uses.
// Without script, office.svg shows (on phones hero-office-phone.svg, the phone cut as a still). Styles: hero.css (imported here; layouts at its end), and .hero itself in src/styles/hero-section.css.
import Drawing from '../Drawing.astro';
import flows from './hero-flows.svg?raw';
// the light theme's colours for the drawings inside the page (this hero and Grow, both on Home only): written by
// tools/gen_light.py, and first here so hero.css and grow.css still come after it
import '../../styles/theme-drawings.css';
import './hero.css';
import Icon from '../Icon.astro';
import Sep from '../Sep.astro';
import { HERO, getServices } from '../../lib/site';
import Pause from '../Pause.astro';
import HoldButton from '../HoldButton.astro';
import { copy } from '../../lib/copy';
const t = (await copy('home')).hero;
// the two news cards under the drawing. The tag (a dot and a word) comes after the title in the markup, so a screen
// reader says "IT and security check-up. Free. 30 minutes…"; hero.css puts it back on top on screen.
const news = [
  {
    href: '/contact#message',
    book: true,
    img: 'security',
    tone: 'accent',
    tag: t.news.checkup.tag,
    title: t.news.checkup.title,
    line: t.news.checkup.line,
  },
  {
    href: '/soon#windows-10-guide',
    book: false,
    img: 'cloud',
    tone: 'sky',
    tag: t.news.windows.tag,
    title: t.news.windows.title,
    line: t.news.windows.line,
  },
];
// the menu under the button: the featured services, then the first of the rest (Cloud workspace, by order), each its
// own page. Services.astro starts its short tiles after that one. A list, not a <nav>: the header holds the one main menu.
const services = await getServices();
const menu = [...services.filter((s) => s.data.featured), services.filter((s) => !s.data.featured)[0]].map(
  ({ id, data: s }) => ({ href: `/services/${id}`, icon: s.icon, title: s.title, sub: s.card }),
);
const still = t.alt;
---

<section class="hero fold fold-always" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-menu">
      <div class="hero-top">
        <p class="eyebrow">
          <span>{t.eyebrow.map((part, i) => <Fragment>{i > 0 && <Sep />}{part}</Fragment>)}</span>
        </p>
        <h1 id="hero-title"><span class="line">{t.title}</span> <em class="line">{t.accent}</em></h1>
        <p class="lead">{t.lead}</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog"
          >{t.cta}<Icon name="arrow"
        /></a>
        <span class="small muted">{t.ctaNote}</span>
      </div>
      <div class="hero-services">
        <p class="label menu-label" id="hero-menu-label">{t.menu}</p>
        <ul class="menu" aria-labelledby="hero-menu-label">
          {menu.map(({ href, icon, title, sub }) => <li>
            <a class="mi" href={href}>
              <span class="icon-tile" aria-hidden="true"><Icon name={icon} /></span>
              <span class="mi-text"
                ><span class="mi-title">{title}</span><Pause /><span class="mi-sub">{sub}</span></span
              >
              <Icon name="chevronR" class="mi-go" />
            </a>
          </li>)}
        </ul>
      </div>
    </div>

    <div class="hero-art">
      <div
        class="stage"
        data-hero={HERO.full}
        data-hero-tablet={HERO.tablet}
        data-hero-phone={HERO.phone}
        data-hero-phone-flows={HERO.phoneFlows}
        data-tablet={HERO.media.tablet}
      >
        <noscript
          ><picture
            ><source media={HERO.media.phone} srcset={HERO.still} width="962" height="900" />
            <img class="hero-nojs" src="/assets/img/office.svg" alt={still} width="1200" height="800"
          /></picture></noscript
        >
        <!-- the same still picture for home.js to clone when the drawings can't load (a template, so no text becomes HTML) -->
        <template class="hero-still"
          ><Drawing
            src="/assets/img/office.svg"
            sources={[{ media: HERO.media.phone, srcset: HERO.still, width: 962, height: 900 }]}
            class="hero-nojs"
            alt={still}
            width="1200"
            height="800"
        /></template>
        <Fragment set:html={flows} />
        <!-- stops every moving part on the page (WCAG 2.2.2); core.js wires it, so it shows only with script and motion -->
        <HoldButton class="hero-pause" />
      </div>
      <div class="hero-dock">
        {news.map((n) => <a class="card news" href={n.href} data-open={n.book ? 'book-dialog' : undefined}>
          <span class="news-thumb well"
            ><Drawing src={`/assets/img/${n.img}-card.svg`} alt="" width="640" height="480" loading="lazy"
          /></span>
          <span class="news-text"
            ><span class="news-title">{n.title}</span
            ><Pause /><span class={`news-tag news-tag--${n.tone}`}>{n.tag}</span
            ><Pause /><span class="small muted">{n.line}</span></span
          >
        </a>)}
      </div>
    </div>
  </div>
</section>
