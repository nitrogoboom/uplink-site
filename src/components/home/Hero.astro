---
// HOME · 1. Hero (first screen): headline, "Get started" button, main menu, office drawing and news cards.
// Drawing: one of three cuts (HERO, in src/lib/site.ts), fetched by home.js for the screen it's on: hero-office.svg, or its tablet
// cut hero-office-tablet.svg, both under the moving dashes' own layer in hero-flows.svg, inlined here; phones get the animated
// phone cut office-compact-build.svg with its own dashes. All written by tools/gen_office.py; don't edit by hand.
// The dashes come in as text (?raw): a plain import would also write a copy to dist/_astro that nothing uses.
// Without script, office.svg shows (office-compact.svg on phones). Styles: hero.css (imported here; layouts at its end), and .hero itself in src/styles/hero.css.
import flows from './hero-flows.svg?raw';
import './hero.css';
import { HERO } from '../../lib/site';
---
<section class="hero fold" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-menu">
      <div class="hero-top">
        <p class="eyebrow">Managed IT · Ontario</p>
        <h1 id="hero-title"><span class="line">Your IT team,</span> <em class="line">always online</em></h1>
      <p class="lead">We run the technology behind your business: help desk, security, cloud, network and phones. You run the business.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn--primary btn--lg" href="/contact#message" data-open="book-dialog">Get started<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <span class="small muted">Free check-up. No contract to look.</span>
      </div>
      <nav aria-label="Home page menu">
        <p class="label menu-label">Main menu</p>
        <ul class="menu">
          <li>
            <a class="mi" href="/services">
              <span class="icon-tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg></span>
              <span class="mi-text"><span class="mi-title">Services</span><span class="mi-sub">Help desk, security, cloud, networks, phones</span></span>
              <svg class="mi-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
          </li>
          <li>
            <a class="mi" href="/work">
              <span class="icon-tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9.5l4.5 2.5-4.5 2.5z"/></svg></span>
              <span class="mi-text"><span class="mi-title">Our work</span><span class="mi-sub">Setups we built and still run</span></span>
              <svg class="mi-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
          </li>
          <li>
            <a class="mi" href="/about">
              <span class="icon-tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M15 9h3a1 1 0 0 1 1 1v11M3 21h18M8.5 8h3M8.5 12h3M8.5 16h3"/></svg></span>
              <span class="mi-text"><span class="mi-title">About</span><span class="mi-sub">The people behind the screen</span></span>
              <svg class="mi-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
          </li>
          <li>
            <a class="mi" href="/contact">
              <span class="icon-tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-5 4z"/></svg></span>
              <span class="mi-text"><span class="mi-title">Contact</span><span class="mi-sub">Talk to a real person</span></span>
              <svg class="mi-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="hero-art">
      <div class="stage" data-hero={HERO.full} data-hero-tablet={HERO.tablet} data-hero-phone={HERO.phone} data-hero-phone-flows={HERO.phoneFlows} data-tablet={HERO.media.tablet}>
        <noscript><picture><source media={HERO.media.phone} srcset="/assets/img/office-compact.svg"><img class="hero-nojs" src="/assets/img/office.svg" alt="Office floor plan with desks, a firewall rack, Wi-Fi and a cloud workspace" width="1200" height="800"></picture></noscript>
        <Fragment set:html={flows} />
        <!-- phones with reduced motion only (compact-cuts.css): other screens get a 1px blank instead, so they don't
             download the still (phones with motion get the animated cut from home.js). Where it shows it is the largest
             paint, so index.astro preloads it there and it is asked for first. -->
        <picture><source media="(min-width: 600px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="><source media="(prefers-reduced-motion: no-preference)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="><img class="hero-still" fetchpriority="high" src="/assets/img/office-compact.svg" alt="Office floor plan with desks, a firewall rack, Wi-Fi and a cloud workspace" width="1200" height="900"></picture>
      </div>
      <div class="hero-dock">
        <a class="card news" href="/contact#message" data-open="book-dialog">
          <span class="news-thumb well"><img src="/assets/img/security-compact.svg?card#plain" alt="" width="640" height="480" fetchpriority="low"></span>
          <span class="news-text"><span class="chip chip--accent">Free</span><span class="news-title">IT and security check-up</span><span class="small muted">30 minutes. We look first, then quote.</span></span>
        </a>
        <a class="card news" href="/soon#windows-10-guide">
          <span class="news-thumb well"><img src="/assets/img/cloud-compact.svg?card#plain" alt="" width="640" height="480" fetchpriority="low"></span>
          <span class="news-text"><span class="chip chip--sky">Guide</span><span class="news-title">Windows 10 support has ended</span><span class="small muted">Your upgrade plan, step by step</span></span>
        </a>
      </div>
    </div>
  </div>
</section>
