---
// HOME · 1. Hero (first screen): headline, "Get started" button, main menu, office drawing and news cards.
// Drawing: the office as a stack of layers (floor, walls, furniture, network, cloud, dashes, label lines), each its
// own <svg> written by tools/gen_office.py into ./hero/ (don't edit by hand) and inlined here as saved, so it shows with the
// page, script or not. The labels' words are page text over it, from the copy, each set where its line ends
// (hero-place.css, also written by gen_office.py). hero.css builds it in layer by layer; home.js steps the cloud
// through its apps and moves the dashes. Phones frame it closer and keep only the cloud's label, in a corner.
// Styles: hero.css (imported here; layouts at its end), and .hero itself in src/styles/hero-section.css.
// the light theme's colours for the drawings inside the page (this hero and Grow, both on Home only): written by
// tools/gen_light.py, and first here so hero.css and grow.css still come after it
import '../../styles/theme-drawings.css';
import '../../styles/hero-drawing.css'; // the layers' own rules, written by tools/gen_office.py
import './hero-place.css'; // the phone framing and the labels' places, written by tools/gen_office.py
import './hero.css';
import Drawing from '../Drawing.astro';
import Icon from '../Icon.astro';
import Sep from '../Sep.astro';
import { getServices } from '../../lib/site';
import Pause from '../Pause.astro';
import HoldButton from '../HoldButton.astro';
import { copy } from '../../lib/copy';
import { linker } from '../../lib/i18n';
const to = linker(Astro.currentLocale);
const { hero: t, cloud } = await copy('home', Astro.currentLocale);
// the layers, back to front (their files are numbered in that order); ?raw: the text, inlined, with no copy in dist
const layers = Object.entries(
  import.meta.glob<string>('./hero/*.svg', { query: '?raw', import: 'default', eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([, svg]) => svg);
const apps = Object.entries(cloud.apps);
// the two news cards under the drawing. The tag (a dot and a word) comes after the title in the markup, so a screen
// reader says "IT and security check-up. Free. 30 minutes…"; hero.css puts it back on top on screen.
const news = [
  {
    href: to('/contact#message'),
    book: true,
    img: 'security',
    tone: 'accent',
    tag: t.news.checkup.tag,
    title: t.news.checkup.title,
    line: t.news.checkup.line,
  },
  {
    href: to('/soon#windows-10-guide'),
    book: false,
    img: 'cloud',
    tone: 'sky',
    tag: t.news.windows.tag,
    title: t.news.windows.title,
    line: t.news.windows.line,
  },
];
// the menu under the button: the featured services, then the first of the rest (Cloud workspace, by order), each its
// own page. Services.astro starts its short tiles after that one. A list, not a <nav>: the header holds the one main menu.
const services = await getServices(Astro.currentLocale);
const menu = [...services.filter((s) => s.data.featured), services.filter((s) => !s.data.featured)[0]].map(
  ({ id, data: s }) => ({ href: to(`/services/${id}`), icon: s.icon, title: s.title, sub: s.card }),
);
---

<section class="hero fold fold-always" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-menu">
      <div class="hero-top">
        <p class="eyebrow">
          <span>{t.eyebrow.map((part, i) => <Fragment>{i > 0 && <Sep />}{part}</Fragment>)}</span>
        </p>
        <h1 id="hero-title"><span class="line">{t.title}</span> <em class="line">{t.accent}</em></h1>
        <p class="lead">{t.lead}</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn--primary btn--lg" href={to('/contact#message')} data-open="book-dialog"
          >{t.cta}<Icon name="arrow"
        /></a>
        <span class="small muted">{t.ctaNote}</span>
      </div>
      <div class="hero-services">
        <p class="label menu-label" id="hero-menu-label">{t.menu}</p>
        <ul class="menu" aria-labelledby="hero-menu-label">
          {menu.map(({ href, icon, title, sub }) => <li>
            <a class="mi" href={href}>
              <span class="icon-tile" aria-hidden="true"><Icon name={icon} /></span>
              <span class="mi-text"
                ><span class="mi-title">{title}</span><Pause /><span class="mi-sub">{sub}</span></span
              >
              <Icon name="chevronR" class="mi-go" />
            </a>
          </li>)}
        </ul>
      </div>
    </div>

    <div class="hero-art">
      <div class="stage">
        <div class="hl-box">
          <div class="hl" role="img" aria-label={t.alt}>
            {layers.map((svg) => (
              <Fragment set:html={svg} />
            ))}
          </div>
          {/* the labels' words, each where its drawn line ends (hero-place.css); the drawing's name says what it shows */}
          <div class="hl-tags" aria-hidden="true">
            {Object.entries(t.labels).map(([key, tag]) => <p class="hl-tag" data-tag={key}>
              <span class="hl-tag-t">{tag.title}</span><span class="hl-tag-s">{tag.line}</span>
            </p>)}
            {/* the cloud's: one app at a time (home.js), each also lighting its tile in the drawing */}
            <p class="hl-tag" data-tag="cloud">
              <span class="hl-tag-t">{cloud.title}</span
              ><span class="hl-apps"
                >{apps.map(([id, app], i) => <span class:list={['hl-app', { 'is-on': i === 0 }]} data-app={id}
                  ><span class="hl-tag-s"><b>{app.name}</b> · {app.detail}</span
                  ><span class="hl-state">{app.state}</span></span
                >)}</span
              >
            </p>
          </div>
        </div>
        {/* stops every moving part on the page (WCAG 2.2.2); core.js wires it, so it shows only with script and motion */}
        <HoldButton class="hero-pause" />
      </div>
      <div class="hero-dock">
        {news.map((n) => <a class="card news" href={n.href} data-open={n.book ? 'book-dialog' : undefined}>
          <span class="news-thumb well"
            ><Drawing src={`${n.img}-card.svg`} alt="" width="640" height="480" loading="lazy"
          /></span>
          <span class="news-text"
            ><span class="news-title">{n.title}</span
            ><Pause /><span class={`news-tag news-tag--${n.tone}`}>{n.tag}</span
            ><Pause /><span class="small muted">{n.line}</span></span
          >
        </a>)}
      </div>
    </div>
  </div>
</section>
