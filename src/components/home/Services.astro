---
// HOME · 2. Services, laid out like a game-mode menu: the featured services are tall cards, then SLOTS short tiles;
// the last short tile is always "All services", a link to the Services page. Phones get the same cards in one
// swipe row (home.js lights the dots). Styles: services.css (imported here). Desktop layout: at the end of its CSS.
import { getCollection } from 'astro:content';
import Icon, { type IconName } from '../Icon.astro';
import './services.css';
const SLOTS = 4;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const tiles = [
  ...services.filter((s) => s.data.featured).map((s) => ({ ...s, size: 'big' })),
  ...services.filter((s) => !s.data.featured).slice(0, SLOTS - 1).map((s) => ({ ...s, size: 'small' })),
];
---
<section class="section section--band fold" id="services" aria-labelledby="services-title">
  <div class="container svc-wrap">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">What we run</p>
        <h2 id="services-title">Everything your office runs on</h2>
      </div>
      <a class="link-arrow" href="/services">See all services<Icon name="arrow" /></a>
    </div>
    <ul class="svc-menu" aria-label="Services">
      {tiles.map(({ id, size, data: s }) => (
        <li class={`svc-${size}`}><a class="svc-tile" href={`/services/${id}`}>
          <span class="svc-art"><img src={`/assets/img/${s.image}-compact.svg?card#plain`} alt="" width="640" height="480" loading="lazy"></span>
          <span class="svc-icon"><Icon name={s.icon as IconName} /></span>
          <span class="svc-text"><span class="chip">{s.chip}</span><span class="svc-title">{s.title}</span><span class="svc-line">{s.card}</span></span>
          <span class="svc-go" aria-hidden="true">View service<Icon name="chevronR" /></span>
        </a></li>
      ))}
      <li class="svc-small svc-more"><a class="svc-tile" href="/services">
        <span class="svc-icon"><Icon name="grid" /></span>
        <span class="svc-text"><span class="svc-title">All services</span><span class="svc-line">See all {services.length} on one page.</span></span>
        <span class="svc-go" aria-hidden="true">View services<Icon name="chevronR" /></span>
      </a></li>
    </ul>
    <p class="svc-hint" aria-hidden="true" data-md-skip><span class="svc-dots">{[...tiles, null].map(() => <i />)}</span><span class="svc-swipe">Swipe<Icon name="arrow" /></span></p>
  </div>
</section>
