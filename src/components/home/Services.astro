---
// HOME · 2. Services: one card per service from the collection, each linking to the service's own page.
// Styles: src/styles/svc-cards.css (shared with Contact). Desktop layout: at the end of its CSS.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<section class="section section--band fold" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">What we run</p>
        <h2 id="services-title">Everything your office runs on</h2>
      </div>
      <a class="link-arrow" href="/services">Compare all services<Icon name="arrow" /></a>
    </div>
    <ul class="svc-cards">
      {services.map(({ id, data: s }) => (
        <li><a class="card" href={`/services/${id}`}>
          <span class="card-media well"><img src={`/assets/img/${s.image}-compact.svg?card#plain`} alt="" width="640" height="480" loading="lazy"></span>
          <span class="card-body"><span class="chip">{s.chip}</span><span class="card-title">{s.title}</span><span class="muted">{s.card}</span></span>
        </a></li>
      ))}
    </ul>
  </div>
</section>
