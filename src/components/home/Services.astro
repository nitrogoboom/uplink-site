---
// HOME · 2. Services, laid out like a game-mode menu: the featured services are tall cards, then SLOTS short tiles;
// the last short tile is always "All services", a link to the Services page. Phones get the same cards in one
// swipe row (home.js lights the dots); with a mouse, arrows beside the dots step through it. Styles: services.css (imported here). Desktop layout: at the end of its CSS.
// A tile is a box whose link (.svc-link) holds its chip, title and line, and its ::after covers the whole tile, so a
// click anywhere opens it (as the project cards do). The link reads "Support. Managed help desk. Real people… View
// service": the chip and "View service" are heard too, so the name starts with the word the eye reads first and voice
// control finds it (review M10); the "View service" bar is its picture (aria-hidden). A tall card also lists its
// service's three features (`features`, the copy its own page shows) outside the link, so they are read as a list and
// not as part of its name (release audit, November 9, 2026); on desktop only, where it has the room.
import Drawing from '../Drawing.astro';
import Icon from '../Icon.astro';
import Pause from '../Pause.astro';
import './services.css';
import { getServices } from '../../lib/site';
import { fit } from '../../lib/fit';
const SLOTS = 4;
const TITLE = 'Everything your office runs on';
const MORE = 'All services';
const services = await getServices();
// services.css lays out exactly three tall cards (four columns each on tablet, a column each on desktop), so a
// different count stops the build here instead of leaving a broken grid
const featured = services.filter((s) => s.data.featured);
if (featured.length !== 3)
  throw new Error(
    `Home services: ${featured.length} services have "featured": true; the layout takes exactly 3 (src/content/services/*.json)`,
  );
const tiles = [
  ...featured.map((s) => ({ ...s, size: 'big' })),
  ...services
    .filter((s) => !s.data.featured)
    .slice(0, SLOTS - 1)
    .map((s) => ({ ...s, size: 'small' })),
];
---

<section class="section section--band fold" id="services" aria-labelledby="services-title">
  <div class="container svc-wrap">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">What we run</p>
        <h2 id="services-title" class={fit(TITLE)}>{TITLE}</h2>
      </div>
      <a class="link-arrow" href="/services">See all services<Icon name="arrow" /></a>
    </div>
    <ul class="svc-menu" id="services-row" aria-label="Services">
      {tiles.map(({ id, size, data: s }) => <li class={`svc-${size}`}>
        <div class="svc-tile">
          <span class="svc-art"
            ><Drawing src={`/assets/img/${s.image}-card.svg`} alt="" width="640" height="480" loading="lazy"
          /></span>
          <span class="svc-icon"><Icon name={s.icon} /></span>
          <div class="svc-text">
            <a class="svc-link" href={`/services/${id}`}
              ><span class="chip">{s.chip}<Pause /></span><span class:list={['svc-title', fit(s.title)]}>{s.title}</span
              ><Pause /><span class="svc-line">{s.card}</span><span class="sr-only"> View service</span></a
            >{size === 'big' && <ul class="svc-feats">
              {s.features.map((f) => <li class="svc-feat">
                <span class="svc-feat-t">{f.title}</span><span class="sr-only">: </span
                ><span class="svc-feat-d">{f.detail}</span>
              </li>)}
            </ul>}
          </div>
          <span class="svc-go" aria-hidden="true">View service<Icon name="chevronR" /></span>
        </div>
      </li>)}
      <li class="svc-small svc-more">
        <div class="svc-tile">
          <span class="svc-icon"><Icon name="grid" /></span>
          <div class="svc-text">
            <a class="svc-link" href="/services"
              ><span class:list={['svc-title', fit(MORE)]}>{MORE}</span><span class="sr-only"> View services</span></a
            >
          </div>
          <span class="svc-go" aria-hidden="true">View services<Icon name="chevronR" /></span>
        </div>
      </li>
    </ul>
    <div class="svc-hint" data-md-skip>
      <button
        class="iconbtn svc-step"
        type="button"
        data-step="-1"
        aria-controls="services-row"
        aria-label="Previous service"
      >
        <Icon name="chevronL" />
      </button>
      <span class="svc-dots" aria-hidden="true"
        >{[...tiles, null].map(() => (
          <i class="pip" />
        ))}</span
      >
      <button
        class="iconbtn svc-step"
        type="button"
        data-step="1"
        aria-controls="services-row"
        aria-label="Next service"
      >
        <Icon name="chevronR" />
      </button>
      <span class="svc-swipe" aria-hidden="true">Swipe<Icon name="arrow" /></span>
    </div>
  </div>
</section>
