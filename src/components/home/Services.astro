---
// HOME · 2. Services: one card per service, linking to the Services page.
// Styles: services.css (imported here). Desktop layout: src/styles/desktop.css.
import './services.css';
---
<section class="section section--band fold" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">What we run</p>
        <h2 id="services-title">Everything your office runs on</h2>
      </div>
      <a class="link-arrow" href="/services">Compare all services<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <ul class="svc-cards">
      <li><a class="card" href="/services#help-desk">
        <span class="card-media well"><img src="/assets/img/helpdesk-compact.svg?card#plain" alt="" width="640" height="480" loading="lazy"></span>
        <span class="card-body"><span class="chip">Support</span><span class="card-title">Managed help desk</span><span class="muted">Real people who pick up and fix it, by phone, email or chat.</span></span>
      </a></li>
      <li><a class="card" href="/services#security">
        <span class="card-media well"><img src="/assets/img/security-compact.svg?card#plain" alt="" width="640" height="480" loading="lazy"></span>
        <span class="card-body"><span class="chip">Protect</span><span class="card-title">Cybersecurity</span><span class="muted">Devices, email and accounts watched around the clock.</span></span>
      </a></li>
      <li><a class="card" href="/services#cloud">
        <span class="card-media well"><img src="/assets/img/cloud-compact.svg?card#plain" alt="" width="640" height="480" loading="lazy"></span>
        <span class="card-body"><span class="chip">Build</span><span class="card-title">Cloud workspace</span><span class="muted">Microsoft 365 or Google Workspace, set up properly and licensed right.</span></span>
      </a></li>
      <li><a class="card" href="/services#network">
        <span class="card-media well"><img src="/assets/img/network-compact.svg?card#plain" alt="" width="640" height="480" loading="lazy"></span>
        <span class="card-body"><span class="chip">Build</span><span class="card-title">Networks &amp; Wi-Fi</span><span class="muted">Firewalls and Wi-Fi that reach every corner of the office.</span></span>
      </a></li>
      <li><a class="card" href="/services#voip">
        <span class="card-media well"><img src="/assets/img/voip-compact.svg?card#plain" alt="" width="640" height="480" loading="lazy"></span>
        <span class="card-body"><span class="chip">Connect</span><span class="card-title">Phones &amp; Teams calling</span><span class="muted">Your numbers on desk phones, laptops and mobiles.</span></span>
      </a></li>
      <li><a class="card" href="/services#backup">
        <span class="card-media well"><img src="/assets/img/backup-compact.svg?card#plain" alt="" width="640" height="480" loading="lazy"></span>
        <span class="card-body"><span class="chip">Protect</span><span class="card-title">Backup &amp; recovery</span><span class="muted">Offsite copies, tested every quarter so a restore works.</span></span>
      </a></li>
      <li><a class="card" href="/services#strategy">
        <span class="card-media well"><img src="/assets/img/strategy-compact.svg?card#plain" alt="" width="640" height="480" loading="lazy"></span>
        <span class="card-body"><span class="chip">Plan</span><span class="card-title">IT strategy &amp; planning</span><span class="muted">A yearly roadmap and budget, reviewed every quarter.</span></span>
      </a></li>
    </ul>
  </div>
</section>
