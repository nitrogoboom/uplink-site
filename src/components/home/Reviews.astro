---
// HOME · 5. What clients say: a line of stars and the "sample" note beside the heading, then one big review across the
// top and three small ones under it, from src/data/reviews.json. Sample reviews for now; the real ones come from Google
// later (notes.md). No score or count until then, and no review JSON-LD: Google ignores a business's own reviews of
// itself, and these are samples.
// Each review is a <figure>: the quote first (a screen reader hears it before who said it), then the name, role and
// date. The hidden ", " between parts: "Dana Whitfield, Office manager, Whitfield & Lo, October 2026".
// Styles: reviews.css.
import Icon from '../Icon.astro';
import Sep from '../Sep.astro';
import './reviews.css';
import { getReviews } from '../../lib/site';
import { copy } from '../../lib/copy';
import { fit } from '../../lib/fit';
const t = (await copy('home')).reviews;
const reviews = await getReviews();
const big = reviews.find((r) => r.featured) ?? reviews[0];
const rest = reviews.filter((r) => r !== big);
// "2026-10" → "October 2026"
const month = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleDateString('en-CA', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<section class="section fold" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="reviews-title" class={fit(`${t.title} ${t.accent}`)}>{t.title} <em>{t.accent}</em></h2>
      </div>
      <div class="rev-score">
        <span class="rev-stars" aria-hidden="true"
          >{Array.from({ length: 5 }, () => (
            <Icon name="star" />
          ))}</span
        >
        <span class="small muted">{t.sample}</span>
        <a class="link-arrow" href="/soon">{t.readAll}<Icon name="arrow" /></a>
      </div>
    </div>

    <ul class="rev-grid" aria-label={t.list}>
      {[big, ...rest].map((r) => <li class:list={['rev panel', { 'rev--big': r === big }]}>
        <figure class="rev-fig">
          {r === big && <Icon name="quote" class="rev-mark" />}
          <blockquote class="rev-quote">
            <p>{r.quote}</p>
          </blockquote>
          <figcaption class="rev-who">
            <span class="rev-avatar" aria-hidden="true">{r.initials}</span>
            <span class="rev-id">
              <span class="rev-name">{r.name}</span>
              <span class="sr-only">, </span>
              <span class="small muted">{r.role}<Sep />{r.company}</span>
              <span class="sr-only">, </span>
              <time class="small muted" datetime={r.date}>{month(r.date)}</time>
            </span>
          </figcaption>
        </figure>
      </li>)}
    </ul>
  </div>
</section>
