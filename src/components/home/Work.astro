---
// HOME · 4. Our work: the first three projects from the collection, each linking to its case study, and a link to
// all of them. A placeholder until this spot's real section is decided (notes.md).
// Styles: shared (.card-row in src/styles/shared-blocks.css); the desktop fold in work.css (imported here).
import Icon from '../Icon.astro';
import './work.css';
import ProjectCard from '../work/ProjectCard.astro';
import { getProjects } from '../../lib/site';
import { copy } from '../../lib/copy';
const projects = (await getProjects()).slice(0, 3);
const t = (await copy('home')).work;
---

<section class="section section--band fold" id="work" aria-labelledby="work-title">
  <div class="container work-wrap">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="work-title">{t.title}</h2>
      </div>
      <a class="link-arrow" href="/work">{t.seeAll}<Icon name="arrow" /></a>
    </div>
    <ul class="card-row">
      {projects.map((project) => <li><ProjectCard project={project} /></li>)}
    </ul>
  </div>
</section>
