---
// HOME · 3. We grow with you: the six-step world and its controls, played by src/scripts/grow.js (which describes how
// it plays). Copy: src/data/grow.json. Styles: grow.css (imported here). Desktop layout: at the end of its CSS.
// The steps are one list (.grow-list): each row holds its step's button and its card. On desktop the buttons are a
// growth line in the left column, in place of the dots and arrows under the picture, and the open step's card opens
// under its button; on phones and tablets the buttons hide and the open card sits under the picture. CSS shows the
// dots or the buttons, so the steps are read once at every size. A button is named by its own words, the place.
// Without script the whole world shows, finished, with every step's card in the list.
// Drawing: grow-world.svg, written by tools/gen_grow.py. Don't edit it by hand. Inlined as text (?raw) and shrunk
// with the site's SVGO settings; its own <style> (the drawings' print rule) is dropped, nothing here needs it.
import raw from './grow-world.svg?raw';
import { optimize } from 'svgo';
import { SVGO } from '../../../scripts/svgo-config.mjs';
import Icon from '../Icon.astro';
import { getGrow } from '../../lib/site';
import { copy, fill } from '../../lib/copy';
import './grow.css';

const steps = await getGrow(); // src/data/grow.json, typed in content.config.ts

const world = optimize(raw, SVGO)
  .data.replace(/<style>[\s\S]*?<\/style>/g, '')
  .replace(' id="plain"', '');
const last = steps.length - 1;
const t = (await copy('home')).grow;
---

<section class="section fold grow-section" id="grow" aria-labelledby="grow-title">
  <div class="container">
    <div class="grow" data-steps={steps.length}>
      <div class="section-head grow-head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="grow-title">{t.title}</h2>
        <p class="lead">{t.lead}</p>
      </div>
      <div class="grow-player">
        <div class="grow-stage">
          <span class="grow-place" aria-hidden="true">{steps[last].place}</span>
          <Fragment set:html={world} />
          {steps.map((s, i) =>
            s.tags.map((t, k) => <span
              class="grow-tag"
              aria-hidden="true"
              data-step={i}
              data-k={k}
              data-at={t.at}
              data-risk={t.risk}
              data-fix={t.fix}
              ><span class="grow-tag-i">!</span><span class="grow-tag-t">{t.risk}</span></span
            >),
          )}
          <button type="button" class="grow-play" aria-label={t.play.pause}>
            <svg class="grow-play-i" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
            <svg class="grow-ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="49.5" /></svg>
          </button>
        </div>
        <div class="grow-nav" role="group" aria-label={t.steps}>
          <button type="button" class="iconbtn grow-step-btn" data-dir="-1" aria-label={t.previous}>
            <Icon name="chevronL" />
          </button>
          <span class="grow-dots">
            {steps.map((s, i) => <button
              type="button"
              class="grow-dot"
              data-i={i}
              aria-label={fill(t.dot, { i: i + 1, n: steps.length, place: s.place })}
            >
              <i class="pip"></i>
            </button>)}
          </span>
          <button type="button" class="iconbtn grow-step-btn" data-dir="1" aria-label={t.next}>
            <Icon name="chevronR" />
          </button>
        </div>
      </div>
      <ol class="grow-list" aria-label={t.steps}>
        {steps.map((s, i) => <li class="grow-step">
          <button type="button" class="grow-item" data-i={i}>
            <span class="grow-mark" aria-hidden="true"><Icon name="check" /></span>{s.place}
          </button>
          <div class="grow-card" data-i={i} data-place={s.place}>
            <h3>{s.title}</h3>
            <div class="grow-rows">
              <div class="grow-row grow-watch">
                <span class="grow-lbl"><i></i>{t.watch}</span>
                <p>{s.watch}</p>
              </div>
              <div class="grow-row grow-handle">
                <span class="grow-lbl"><i></i>{t.handle}</span>
                <p>{s.handle}</p>
              </div>
            </div>
          </div>
        </li>)}
      </ol>
    </div>
  </div>
</section>
