---
// HOME · 3. We grow with you: the six-step world and its controls, played by src/scripts/grow.js (which describes how
// it plays). Copy: src/data/grow.json. Styles: grow.css (imported here). Desktop layout: at the end of its CSS.
// The steps are one list (.grow-list): each row holds its step's button and its card. On desktop the buttons are a
// growth line in the left column, in place of the dots and arrows under the picture, and the open step's card opens
// under its button; on phones and tablets the buttons hide and the open card sits under the picture. CSS shows the
// dots or the buttons, so the steps are read once at every size. A button is named by its own words, the place.
// Without script the whole world shows, finished, with every step's card in the list.
// Drawing: grow-world.svg, written by tools/gen_grow.py. Don't edit it by hand. Inlined as text (?raw); its own
// <style> (the drawings' print rule) is dropped, nothing here needs it.
// It goes in as layers, one <svg> each in its drawing order: the ground (with the shared defs and the tags'
// anchors), then each part (.pc) on its own. A part dropping in then moves as one box, which the browser moves
// without drawing the rest again; one drawing, its parts would be redrawn every frame. Parts from different steps
// sit in one another's depth order, so the layers follow the parts, not the steps.
import raw from './grow-world.svg?raw';
import Icon from '../Icon.astro';
import { getGrow } from '../../lib/site';
import { copy, fill } from '../../lib/copy';
import './grow.css';

const steps = await getGrow(); // src/data/grow.json, typed in content.config.ts

const world = raw.replace(/<style>[\s\S]*?<\/style>/g, '');
const viewBox = /viewBox="([^"]+)"/.exec(world)?.[1];
const label = /aria-label="([^"]+)"/.exec(world)?.[1];
// the drawing's one outer group: its paint settings go on each layer's own
const outer = /<title>[\s\S]*?<\/title>\s*(<g\b[^>]*>)/.exec(world)?.[1];
if (!viewBox || !label || !outer) throw new Error('grow-world.svg: no viewBox, aria-label or outer <g> to split by');
const body = world.slice(world.indexOf(outer) + outer.length, world.lastIndexOf('</g>'));
// a <g> that starts at i: where it ends (its matching </g>). An empty one is written <g …/> and opens nothing.
const close = (i: number) => {
  const tags = /<g\b[^>]*>|<\/g>/g;
  tags.lastIndex = i;
  let depth = 0;
  for (let m = tags.exec(body); m; m = tags.exec(body)) {
    if (m[0].endsWith('/>')) continue;
    depth += m[0] === '</g>' ? -1 : 1;
    if (!depth) return m.index + 4;
  }
  throw new Error("grow-world.svg: a part's <g> never closes");
};
const parts: { s: string; o: string; inner: string }[] = [];
let ground = '';
for (let at = 0; at < body.length;) {
  const next = body.indexOf('<g class="pc"', at);
  if (next < 0) {
    ground += body.slice(at);
    break;
  }
  if (parts.length && body.slice(at, next).trim())
    throw new Error('grow-world.svg: something is drawn between two parts, so it would lose its depth');
  if (!parts.length) ground += body.slice(at, next);
  const end = close(next);
  const g = body.slice(next, end);
  const head = g.slice(0, g.indexOf('>') + 1);
  parts.push({
    s: /data-s="(\d+)"/.exec(head)?.[1] ?? '',
    o: /data-o="(\d+)"/.exec(head)?.[1] ?? '',
    inner: g.slice(head.length, -4),
  });
  at = end;
}
const layer = (inner: string) => `${outer}${inner}</g>`;
const last = steps.length - 1;
const t = (await copy('home')).grow;
---

<section class="section fold grow-section" id="grow" aria-labelledby="grow-title">
  <div class="container">
    <div class="grow" data-steps={steps.length}>
      <div class="section-head grow-head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="grow-title">{t.title}</h2>
        <p class="lead">{t.lead}</p>
      </div>
      <div class="grow-player">
        <div class="grow-stage">
          <span class="grow-place" aria-hidden="true">{steps[last].place}</span>
          <div class="grow-world" role="img" aria-label={label}>
            <svg class="gw" viewBox={viewBox} aria-hidden="true" focusable="false" set:html={layer(ground)} />
            {parts.map((pc) => (
              <svg
                class="gw pc"
                data-s={pc.s}
                data-o={pc.o}
                viewBox={viewBox}
                aria-hidden="true"
                focusable="false"
                set:html={layer(pc.inner)}
              />
            ))}
          </div>
          {steps.map((s, i) =>
            s.tags.map((t, k) => <span
              class="grow-tag"
              aria-hidden="true"
              data-step={i}
              data-k={k}
              data-at={t.at}
              data-risk={t.risk}
              data-fix={t.fix}
              ><span class="grow-tag-i">!</span><span class="grow-tag-t">{t.risk}</span></span
            >),
          )}
          <button type="button" class="grow-play" aria-label={t.play.pause}>
            <svg class="grow-play-i" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
            <svg class="grow-ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="49.5" /></svg>
          </button>
        </div>
        <div class="grow-nav" role="group" aria-label={t.steps}>
          <button type="button" class="iconbtn grow-step-btn" data-dir="-1" aria-label={t.previous}>
            <Icon name="chevronL" />
          </button>
          <span class="grow-dots">
            {steps.map((s, i) => <button
              type="button"
              class="grow-dot"
              data-i={i}
              aria-label={fill(t.dot, { i: i + 1, n: steps.length, place: s.place })}
            >
              <i class="pip"></i>
            </button>)}
          </span>
          <button type="button" class="iconbtn grow-step-btn" data-dir="1" aria-label={t.next}>
            <Icon name="chevronR" />
          </button>
        </div>
      </div>
      <ol class="grow-list" aria-label={t.steps}>
        {steps.map((s, i) => <li class="grow-step">
          <button type="button" class="grow-item" data-i={i}>
            <span class="grow-mark" aria-hidden="true"><Icon name="check" /></span>{s.place}
          </button>
          <div class="grow-card" data-i={i} data-place={s.place}>
            <h3>{s.title}</h3>
            <div class="grow-rows">
              <div class="grow-row grow-watch">
                <span class="grow-lbl"><i></i>{t.watch}</span>
                <p>{s.watch}</p>
              </div>
              <div class="grow-row grow-handle">
                <span class="grow-lbl"><i></i>{t.handle}</span>
                <p>{s.handle}</p>
              </div>
            </div>
          </div>
        </li>)}
      </ol>
    </div>
  </div>
</section>
