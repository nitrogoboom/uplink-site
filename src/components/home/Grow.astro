---
// HOME · 3. We grow with you: the six-step world and its controls, played by src/scripts/grow.js (which describes how
// it plays). Copy: src/data/grow.json. Styles: grow.css (imported here). Desktop layout: at the end of its CSS.
// On desktop the steps are a list in the left column (.grow-list) in place of the dots and arrows under the picture;
// CSS shows one or the other, so the steps are read once at every size. Each row is a button named by its own words
// ("1 Your office Team of 8"): an aria-label would have to contain them all (WCAG 2.5.3). Without script the whole
// world shows, finished, with every step's card in a list.
// Drawing: grow-world.svg, written by tools/gen_grow.py. Don't edit it by hand. Inlined as text (?raw) and shrunk
// with the site's SVGO settings; its own <style> (the drawings' print rule) is dropped, nothing here needs it.
import raw from './grow-world.svg?raw';
import { optimize } from 'svgo';
import { SVGO } from '../../../scripts/svgo-config.mjs';
import Icon from '../Icon.astro';
import { getGrow } from '../../lib/site';
import './grow.css';

const steps = await getGrow(); // src/data/grow.json, typed in content.config.ts

const world = optimize(raw, SVGO)
  .data.replace(/<style>[\s\S]*?<\/style>/g, '')
  .replace(' id="plain"', '');
const last = steps.length - 1;
---

<section class="section fold grow-section" id="grow" aria-labelledby="grow-title">
  <div class="container">
    <div class="grow" data-steps={steps.length}>
      <div class="section-head grow-head">
        <p class="eyebrow">Built to scale</p>
        <h2 id="grow-title">We grow with you</h2>
        <p class="lead">As your team spreads out, here's what to watch, and what we take care of.</p>
      </div>
      <ol class="grow-list" aria-label="Where your people work" data-md-skip>
        {steps.map((s, i) => <li>
          <button type="button" class="grow-item" data-i={i}>
            <span class="grow-item-n">{i + 1}</span><span class="grow-item-t">{s.place}</span
            ><span class="grow-item-m">Team of {s.team}</span>
          </button>
        </li>)}
      </ol>
      <div class="grow-player">
        <div class="grow-stage" data-md-skip>
          <span class="grow-place" aria-hidden="true">{steps[last].place}</span>
          <span class="grow-team" aria-hidden="true">Team of {steps[last].team}</span>
          <Fragment set:html={world} />
          {steps.map((s, i) =>
            s.tags.map((t, k) => <span
              class="grow-tag"
              aria-hidden="true"
              data-step={i}
              data-k={k}
              data-at={t.at}
              data-risk={t.risk}
              data-fix={t.fix}
              ><span class="grow-tag-i">!</span><span class="grow-tag-t">{t.risk}</span></span
            >),
          )}
          <button type="button" class="grow-play" aria-label="Pause">
            <svg class="grow-play-i" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
            <svg class="grow-ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="49.5" /></svg>
          </button>
        </div>
        <div class="grow-nav" role="group" aria-label="Where your people work" data-md-skip>
          <button type="button" class="iconbtn grow-step-btn" data-dir="-1" aria-label="Previous place">
            <Icon name="chevronL" />
          </button>
          <span class="grow-dots">
            {steps.map((s, i) => <button
              type="button"
              class="grow-dot"
              data-i={i}
              aria-label={`${i + 1} of ${steps.length}: ${s.place}`}
            >
              <i class="pip"></i>
            </button>)}
          </span>
          <button type="button" class="iconbtn grow-step-btn" data-dir="1" aria-label="Next place">
            <Icon name="chevronR" />
          </button>
        </div>
      </div>
      <ol class="grow-cards">
        {steps.map((s, i) => <li class="grow-card" data-i={i} data-place={s.place} data-team={s.team}>
          <h3>{s.title}</h3>
          <div class="grow-rows">
            <div class="grow-row grow-watch">
              <span class="grow-lbl"><i></i>Watch for</span>
              <p>{s.watch}</p>
            </div>
            <div class="grow-row grow-handle">
              <span class="grow-lbl"><i></i>We handle</span>
              <p>{s.handle}</p>
            </div>
          </div>
        </li>)}
      </ol>
    </div>
  </div>
</section>
