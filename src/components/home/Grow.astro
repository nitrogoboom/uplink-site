---
// HOME · 3. Growing with you. Scroll story: the world grows as you scroll (home.js): floors, then remote staff and a
// security ring, then a second office and a cloud. Phone and tablet: the picture, a level HUD and the active step hold
// still for about three screens while the scroll builds each level. Desktop: the
// picture stays put beside the steps.
// Drawing: grow-tower.svg, written by tools/gen_tower.py. Don't edit it by hand. Inlined as text (?raw): a plain
// import would also write a copy to dist/_astro that nothing uses.
// Tags point at the drawing's anchors (<circle class="tg-a" data-a="…">); data-l is the level they show on.
// Styles: grow.css (imported here). Desktop layout: at the end of its CSS.
import raw from './grow-tower.svg?raw';
import { optimize } from 'svgo';
import { SVGO } from '../../../scripts/svgo-config.mjs';
import Sep from '../Sep.astro';
import './grow.css';

const tags = [
  { l: 1, a: 'door', t: 'Help desk' },
  { l: 1, a: 'mast1', t: 'Backed up' },
  { l: 2, a: 'ring', t: '24/7 watch' },
  { l: 2, a: 'home-a', t: 'Remote staff' },
  { l: 3, a: 'office', t: 'Second office' },
  { l: 3, a: 'cloud', t: 'Cloud' },
];
// Inlined, so scripts/svgo.mjs never sees it: shrunk here with the same settings (about 70 KB -> 50 KB). SVGO writes
// the quotes in its <style> as &quot;, but the CSP hash (scripts/headers.mjs) must match the text the browser
// reads, with plain quotes, or the whole block is blocked: put them back.
const tower = optimize(raw, SVGO).data.replace(/<style>[\s\S]*?<\/style>/g, (css) => css.replaceAll('&quot;', '"'));
---
<section class="section grow-section" id="grow" aria-labelledby="grow-title">
  <div class="container">
    <div class="grow">
      <div class="grow-side">
        <div class="section-head">
          <p class="eyebrow">Built to scale</p>
          <h2 id="grow-title">We grow with you</h2>
          <p class="lead">Start with the basics and add more as your team grows. Same people, same help desk, the whole way.</p>
        </div>
        <div class="grow-art">
          <div class="grow-hud" aria-hidden="true" data-md-skip>
            <span class="chip chip--accent">Level <span class="grow-lvl">1</span></span>
            <span class="grow-count"><span class="grow-num">1</span> people</span>
            <span class="grow-bar"><i></i><i></i><i></i></span>
          </div>
          <Fragment set:html={tower} />
          <div class="grow-tags" aria-hidden="true" data-md-skip>
            {tags.map((g) => <span class="grow-tag" data-l={g.l} data-a={g.a}>{g.t}</span>)}
          </div>
        </div>
      </div>
      <ol class="grow-steps">
        <li class="grow-step" id="grow-l1" data-floors="1"><div class="grow-card panel">
          <span class="chip"><span>Level 1<Sep />1 to 10 people</span></span>
          <h3>Get set up right</h3>
          <p class="muted">A small team needs things to just work. We set up every laptop, phone and account the same way, and you get one number to call.</p>
          <ul>
            <li>Help desk for every person</li>
            <li>Microsoft 365 or Google set up and backed up</li>
            <li>Devices patched and monitored</li>
          </ul>
        </div></li>
        <li class="grow-step" id="grow-l2" data-floors="2"><div class="grow-card panel">
          <span class="chip"><span>Level 2<Sep />11 to 50 people</span></span>
          <h3>Lock it down</h3>
          <p class="muted">More people means more logins to protect. We add round-the-clock security and train your staff to spot a bad email.</p>
          <ul>
            <li>24/7 threat monitoring</li>
            <li>Email and phishing defence</li>
            <li>Staff security training</li>
          </ul>
        </div></li>
        <li class="grow-step" id="grow-l3" data-floors="3"><div class="grow-card panel">
          <span class="chip"><span>Level 3<Sep />51 to 150 people</span></span>
          <h3>Plan ahead</h3>
          <p class="muted">Bigger teams need a plan. We map every device and licence, link your offices, and review the budget with you each quarter.</p>
          <ul>
            <li>Multi-site networks</li>
            <li>Quarterly IT reviews</li>
            <li>Yearly roadmap and budget</li>
          </ul>
        </div></li>
      </ol>
    </div>
  </div>
</section>
