---
// SHARED · Header (every page): logo, page tabs (NAV, src/lib/site.ts), "Get support", "Client portal" and the
// Settings gear (opens SettingsDialog.astro; script only, so it hides without script).
// `current` lights the page's tab: aria-current "page" there, "true" on a page inside its section.
// The first two buttons show icons only on narrow screens and the gear always does, so each carries its full name in
// aria-label.
// Styles: src/styles/header.css.
import type { Page } from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { NAV, PAGES, tabCurrent } from '../lib/site';
import { copy } from '../lib/copy';
interface Props {
  current: Page;
}
const { current } = Astro.props;
const here = Astro.url.pathname;
const { site, header: t, pages } = await copy('ui');
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={t.home}>
      <span class="brand-mark" aria-hidden="true"><Icon name="mark" /></span>
      <span class="brand-text">
        <span class="brand-name">{site.short}</span>
        <span class="brand-sub">{t.sub}</span>
      </span>
    </a>

    <nav class="tabs" aria-label={t.nav}>
      <ul>
        {NAV.map(({ page }) => <li>
          <a class="tab" href={PAGES[page].path} data-page={page} aria-current={tabCurrent(page, current, here)}
            >{pages[page]}</a
          >
        </li>)}
      </ul>
    </nav>

    <div class="hdr-actions">
      <a class="hbtn" href="/contact#support" aria-label={t.support.label}>
        <Icon name="headset" /><span class="hbtn-text">{t.support.text}</span>
      </a>
      <a class="hbtn" href="/soon#client-portal" aria-label={t.portal.label}>
        <Icon name="person" /><span class="hbtn-text">{t.portal.text}</span>
      </a>
      <button
        class="hbtn hbtn-settings"
        type="button"
        data-open="settings-dialog"
        commandfor="settings-dialog"
        command="show-modal"
        aria-label={t.settings}
      >
        <Icon name="gear" />
      </button>
    </div>
  </div>
</header>
