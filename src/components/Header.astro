---
// SHARED · Header (every page): logo, page tabs (NAV, src/lib/site.ts), "Get support" and "Client portal".
// `current` lights the page's tab: aria-current "page" there, "true" on a page inside its section.
// The two buttons show icons only on narrow screens, so each carries its full name in aria-label.
// Styles: src/styles/header.css.
import type { Page } from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { NAV, PAGES, tabCurrent } from '../lib/site';
interface Props { current: Page }
const { current } = Astro.props;
const here = Astro.url.pathname;
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="Uplink Technology management, home">
      <span class="brand-mark" aria-hidden="true"><Icon name="mark" /></span>
      <span class="brand-text">
        <span class="brand-name">Uplink</span>
        <span class="brand-sub">Technology management</span>
      </span>
    </a>

    <nav class="tabs" aria-label="Main">
      <ul>
        {NAV.map(({ page }) => (
          <li><a class="tab" href={PAGES[page].path} data-page={page} aria-current={tabCurrent(page, current, here)}>{PAGES[page].name}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr-actions">
      <a class="hbtn" href="/contact#support" aria-label="Get support (existing clients)">
        <Icon name="headset" /><span class="hbtn-text">Get support</span>
      </a>
      <a class="hbtn" href="/soon#client-portal" aria-label="Client portal sign in">
        <Icon name="person" /><span class="hbtn-text">Client portal</span>
      </a>
    </div>
  </div>
</header>
