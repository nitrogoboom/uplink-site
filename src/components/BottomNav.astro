---
// SHARED · Bottom tab bar (phones only, every page): the same tabs as the header (NAV, src/lib/site.ts).
// `current` lights the page's tab, as in the header. Styles: src/styles/bottom-nav.css.
import type { Page } from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { NAV, PAGES, tabCurrent } from '../lib/site';
interface Props { current: Page }
const { current } = Astro.props;
const here = Astro.url.pathname;
---
<nav class="botnav" aria-label="Main (bottom bar)">
  <ul>
    {NAV.map(({ page, icon, short }) => (
      <li><a class="bn" href={PAGES[page].path} data-page={page} aria-current={tabCurrent(page, current, here)}><Icon name={icon} />{short ?? PAGES[page].name}</a></li>
    ))}
  </ul>
</nav>
