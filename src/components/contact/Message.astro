---
// CONTACT · 1. Contact (first screen): ways to reach us, the message form and the help desk queue ring (contact.js).
// Styles: message.css, plus .facts (src/styles/facts.css). Desktop layout: at the end of its CSS.
// The form is a mockup (core.js checks it and sends nothing). Without script it goes to the coming-soon page, and
// its fields have no name, so nothing typed lands in the address bar. Give them names back with a real endpoint.
import './message.css';
import ServiceOptions from '../ServiceOptions.astro';
import Icon from '../Icon.astro';
import Pause from '../Pause.astro';
import { phone, email } from '../../data/footer.json';
---
<section class="page-intro fold fold-always" id="message" aria-labelledby="contact-title">
  <div class="container">
    <div class="lobby">
      <div class="lobby-intro">
        <p class="eyebrow">Lobby</p>
        <h1 id="contact-title">Talk to a real person</h1>
        <p class="lead">No phone tree and no bots. New here? Send a message or book a check-up. Already a client? Use the help desk options further down.</p>
      </div>
      <div class="lobby-chan">
        <span class="label">Reach us directly</span>
        <div class="chan panel">
          <span class="icon-tile" aria-hidden="true"><Icon name="phone" /></span>
          <span class="chan-text"><span class="chan-title">Call</span><a class="chan-value" id="tel-val" href={phone.href}>{phone.display}</a></span>
          <button class="iconbtn copy-btn" type="button" data-copy={phone.display} data-copy-target="tel-val" aria-label="Copy phone number"><Icon name="copy" /></button>
        </div>
        <div class="chan panel">
          <span class="icon-tile" aria-hidden="true"><Icon name="mail" /></span>
          <span class="chan-text"><span class="chan-title">Email</span><a class="chan-value" id="mail-val" href={`mailto:${email}`}>{email}</a></span>
          <button class="iconbtn copy-btn" type="button" data-copy={email} data-copy-target="mail-val" aria-label="Copy email address"><Icon name="copy" /></button>
        </div>
        <a class="chan panel card" href="/contact#message" data-open="book-dialog">
          <span class="icon-tile" aria-hidden="true"><Icon name="calendar" /></span>
          <span class="chan-text"><span class="chan-title">Book a check-up</span><Pause /><span class="chan-value">Free, 30 minutes</span></span>
        </a>
      </div>

      <div class="lobby-form">
        <form class="form-panel panel" action="/soon" data-validate="contact" aria-labelledby="form-title">
          <div class="form-head">
            <h2 id="form-title">Send us a message</h2>
            <p class="small muted">Fields are required unless marked optional.</p>
          </div>
          <div class="form-body">
            <div class="form-grid">
              <div class="field">
                <label for="c-name">Name</label>
                <input class="input" id="c-name" type="text" autocomplete="name" required pattern=".*\S.*">
                <span class="field-error" id="c-name-err">Add your name so we know who to reply to.</span>
              </div>
              <div class="field">
                <label for="c-email">Work email</label>
                <input class="input" id="c-email" type="email" pattern="[^@\s]+@[^@\s]+\.[^@\s]+" autocomplete="email" placeholder="you@company.com" required>
                <span class="field-error" id="c-email-err">Enter an email like name@company.com.</span>
              </div>
              <div class="field">
                <label for="c-company">Company <span class="opt">(optional)</span></label>
                <input class="input" id="c-company" type="text" autocomplete="organization">
              </div>
              <div class="field">
                <label for="c-topic">What do you need?</label>
                <select class="input" id="c-topic">
                  <option>Free IT check-up</option>
                  <ServiceOptions />
                  <option>Something else</option>
                </select>
              </div>
              <div class="field span-2">
                <label for="c-msg">Message</label>
                <textarea class="input" id="c-msg" required minlength="10" placeholder="Tell us a little about your team and what is going on."></textarea>
                <span class="field-error" id="c-msg-err">Write at least a sentence so we can help.</span>
              </div>
            </div>
          </div>
          <div class="form-foot">
            <span class="small muted">Prototype form: nothing is sent yet.</span>
            <button class="btn btn--primary" type="submit">Send message</button>
          </div>
        </form>
      </div>

      <div class="lobby-queue panel pad" data-queue>
        <div class="row" data-md-skip>
          <span class="label">Queue status</span>
          <span class="chip chip--ok chip--dot" data-queue-text="You're in the queue">Open now</span>
        </div>
        <div class="queue-ring" data-md-skip>
          <svg viewBox="0 0 168 168" aria-hidden="true"><circle class="queue-ring-track" cx="84" cy="84" r="70" fill="none" stroke-width="12"/><circle class="queue-ring-arc" data-queue-arc cx="84" cy="84" r="70" fill="none" stroke-width="12" stroke-linecap="round" stroke-dasharray="120 440" transform="rotate(-90 84 84)"/></svg>
          <div class="queue-ring-label"><span class="label">Reply to new messages</span><Pause /><span class="stat-val">1 day</span></div>
        </div>
        <dl class="facts">
          <div><dt>Monday to Friday</dt><dd>7 am to 7 pm ET</dd></div>
          <div><dt>Weekends</dt><dd>Emergency line</dd></div>
          <div><dt>Monitoring</dt><dd>24/7 for clients</dd></div>
          <div><dt>Office</dt><dd>Toronto, ON</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>
