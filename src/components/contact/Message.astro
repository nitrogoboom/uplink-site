---
// CONTACT · 1. Contact (first screen): ways to reach us, the message form and the help desk queue ring (contact.js).
// Styles: message.css, plus .facts (src/styles/facts.css). Desktop layout: at the end of its CSS.
// The form is a mockup (core.js checks it and sends nothing). Without script it goes to the coming-soon page, and
// its fields have no name, so nothing typed lands in the address bar. Give them names back with a real endpoint.
import './message.css';
import ServiceOptions from '../ServiceOptions.astro';
import Icon from '../Icon.astro';
import Pause from '../Pause.astro';
import { phone, email } from '../../lib/footer';
import { fit } from '../../lib/fit';
import { copy } from '../../lib/copy';
const t = (await copy('contact')).message;
const { form, cta } = await copy('ui');
const TITLE = t.title;
---

<section class="page-intro fold fold-always" id="message" aria-labelledby="contact-title">
  <div class="container">
    <div class="lobby">
      <div class="lobby-intro">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 id="contact-title" class={fit(TITLE)}>{TITLE}</h1>
        <p class="lead">{t.lead}</p>
      </div>
      <div class="lobby-chan">
        <span class="label">{t.direct}</span>
        <div class="chan panel">
          <span class="icon-tile" aria-hidden="true"><Icon name="phone" /></span>
          <span class="chan-text"
            ><span class="chan-title">{t.call}</span
            ><a class="chan-value" id="tel-val" href={phone.href}>{phone.display}</a></span
          >
          <button
            class="iconbtn copy-btn"
            type="button"
            data-copy={phone.display}
            data-copy-target="tel-val"
            aria-label={t.copyPhone}
          >
            <Icon name="copy" />
          </button>
        </div>
        <div class="chan panel">
          <span class="icon-tile" aria-hidden="true"><Icon name="mail" /></span>
          <span class="chan-text"
            ><span class="chan-title">{t.email}</span
            ><a class="chan-value" id="mail-val" href={`mailto:${email}`}
              >{email.split('@')[0]}@<wbr />{email.split('@')[1]}</a
            ></span
          >
          <button
            class="iconbtn copy-btn"
            type="button"
            data-copy={email}
            data-copy-target="mail-val"
            aria-label={t.copyEmail}
          >
            <Icon name="copy" />
          </button>
        </div>
        <a class="chan panel card" href="/contact#message" data-open="book-dialog">
          <span class="icon-tile" aria-hidden="true"><Icon name="calendar" /></span>
          <span class="chan-text"
            ><span class="chan-title">{cta.book}</span><Pause /><span class="chan-value">{t.book}</span></span
          >
        </a>
      </div>

      <div class="lobby-form">
        <form class="form-panel panel" action="/soon" data-validate="contact" aria-labelledby="form-title">
          <div class="form-head">
            <h2 id="form-title">{t.form.title}</h2>
            <p class="small muted">{form.required}</p>
          </div>
          <div class="form-body">
            <div class="form-grid">
              <div class="field">
                <label for="c-name">{form.name.label}</label>
                <input
                  class="input"
                  id="c-name"
                  type="text"
                  autocomplete="name"
                  required
                  pattern=".*\S.*"
                  title={form.name.title}
                />
                <span class="field-error" id="c-name-err">{t.form.nameError}</span>
              </div>
              <div class="field">
                <label for="c-email">{form.email.label}</label>
                <input
                  class="input"
                  id="c-email"
                  type="email"
                  pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
                  title={form.email.title}
                  autocomplete="email"
                  placeholder={form.email.placeholder}
                  required
                />
                <span class="field-error" id="c-email-err">{form.email.error}</span>
              </div>
              <div class="field">
                <label for="c-company">{form.company} <span class="opt">{form.optional}</span></label>
                <input class="input" id="c-company" type="text" autocomplete="organization" />
              </div>
              <div class="field">
                <label for="c-topic">{t.form.topic.label}</label>
                <select class="input" id="c-topic" required>
                  <option value="">{form.choose}</option>
                  <option>{t.form.topic.checkup}</option>
                  <ServiceOptions />
                  <option>{t.form.topic.other}</option>
                </select>
                <span class="field-error" id="c-topic-err">{t.form.topic.error}</span>
              </div>
              <div class="field span-2">
                <label for="c-msg">{t.form.message.label}</label>
                <textarea
                  class="input"
                  id="c-msg"
                  required
                  minlength="10"
                  placeholder={t.form.message.placeholder}
                ></textarea>
                <span class="field-error" id="c-msg-err">{t.form.message.error}</span>
              </div>
            </div>
          </div>
          <div class="form-foot">
            <span class="small muted">{form.prototype}</span>
            <button class="btn btn--primary" type="submit">{t.form.send}</button>
          </div>
        </form>
      </div>

      <div class="lobby-queue panel pad" data-queue>
        <div class="row">
          <span class="label">{t.queue.label}</span>
          <span class="chip chip--ok chip--dot" data-queue-text={t.queue.queued}>{t.queue.open}</span>
        </div>
        <div class="queue-ring">
          <svg viewBox="0 0 168 168" aria-hidden="true">
            <circle class="queue-ring-track" cx="84" cy="84" r="70" fill="none" stroke-width="12" />
            <circle
              class="queue-ring-arc"
              data-queue-arc
              cx="84"
              cy="84"
              r="70"
              fill="none"
              stroke-width="12"
              stroke-linecap="round"
              stroke-dasharray="120 440"
              transform="rotate(-90 84 84)"
            />
          </svg>
          <div class="queue-ring-label">
            <span class="label">{t.queue.reply}</span><Pause /><span class="stat-val">{t.queue.replyIn}</span>
          </div>
        </div>
        <h2 class="sr-only">{t.queue.title}</h2>
        <dl class="facts">
          {t.queue.facts.map((f) => <div>
            <dt>{f.term}</dt>
            <dd>{f.value}</dd>
          </div>)}
        </dl>
      </div>
    </div>
  </div>
</section>
