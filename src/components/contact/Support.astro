---
// CONTACT · 2. Already a client: quick links for existing clients. Each card's title is an h3 holding its link, the
// link covering the card (.card-link in src/styles/surfaces.css; review M3). Styles: support.css.
import './support.css';
import { phone } from '../../lib/footer';
import Icon from '../Icon.astro';
import { fit } from '../../lib/fit';
import { copy, fill } from '../../lib/copy';
const t = (await copy('contact')).support;
const cards = [
  {
    icon: 'headset',
    title: t.cards.call.title,
    href: phone.href,
    text: fill(t.cards.call.text, { phone: phone.display }),
  },
  { icon: 'ticket', href: '/soon#client-portal', ...t.cards.ticket },
  { icon: 'screen', href: '/soon#remote-support', ...t.cards.remote },
] as const;
---

<section class="section section--band fold" id="support" aria-labelledby="support-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="support-title">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <ul class="svc-cards help-cards">
      {cards.map((c) => <li>
        <div class="card pad">
          <span class="icon-tile" aria-hidden="true"><Icon name={c.icon} /></span>
          <h3 class:list={['card-title', fit(c.title)]}><a class="card-link" href={c.href}>{c.title}</a></h3>
          <span class="muted">{c.text}</span>
        </div>
      </li>)}
    </ul>
  </div>
</section>
