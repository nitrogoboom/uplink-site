---
// SHARED · A drawing shown as a picture, in the visitor's theme: the dark NAME.svg and the light NAME-light.svg, one
// hidden by theme-light.css (src/README.md, "Shared components"). A lazy picture that isn't shown isn't fetched, so a
// page loads one copy, and the theme changes at once with nothing for a script to swap. Without script: dark.
//   src       the dark drawing's address, /assets/img/NAME.svg
//   sources   <source>s for a <picture> (another cut on narrower screens): { media, srcset, width?, height? }, dark
//             addresses
//   class     the <img>'s class (the theme's class goes on the <picture> when there is one)
//   anything else goes on the <img> as written (alt, width, height, loading, fetchpriority)
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src'> {
  src: string;
  sources?: { media: string; srcset: string; width?: number; height?: number }[];
}
const { src, sources, class: cls, ...img } = Astro.props;
const light = (path: string) => path.replace(/\.svg$/, '-light.svg');
const themes = [
  { theme: 'th-dark', at: (p: string) => p },
  { theme: 'th-light', at: light },
];
---

{themes.map(({ theme, at }) =>
  sources ? (
    <picture class={theme}>
      {sources.map((s) => (
        <source media={s.media} srcset={at(s.srcset)} width={s.width} height={s.height} />
      ))}
      <img class={cls} src={at(src)} {...img} />
    </picture>
  ) : (
    <img class:list={[theme, cls]} src={at(src)} {...img} />
  ),
)}
