{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run quick)",
      "Bash(python tools/regen.py --check)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git push *)",
      "Bash(npx -y modern-web-guidance@latest *)",
      "PowerShell(npx.cmd -y modern-web-guidance@latest *)",
      "mcp__astro-docs__search_astro_docs",
      "mcp__plugin_cloudflare_cloudflare__docs"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
