{
  "name": "uplink-site",
  "private": true,
  "description": "Uplink Technology mockup site, built with Astro.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "eslint --fix . && stylelint --fix \"src/**/*.css\" && prettier --write .",
    "verify": "python tools/verify_footer.py out",
    "serve": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "playwright": "^1.47.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.154.0"
  }
}
