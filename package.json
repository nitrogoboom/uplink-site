{
  "name": "uplink-site",
  "private": true,
  "description": "Uplink Technology mockup site, built with Astro.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/svgo.mjs && node scripts/markdown.mjs && node scripts/headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"scripts/test/*.test.mjs\"",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "eslint --fix . && stylelint --fix \"src/**/*.css\" && prettier --write .",
    "verify": "node scripts/check.mjs site",
    "verify:zoom": "node scripts/check.mjs zoom",
    "verify:links": "node scripts/check.mjs links",
    "verify:spacing": "node scripts/check.mjs spacing",
    "verify:styles": "node scripts/check.mjs styles",
    "visual-diff": "node scripts/check.mjs visual",
    "ci": "node scripts/ci.mjs",
    "release-audit": "node scripts/check.mjs audit",
    "smoke": "node scripts/check.mjs smoke",
    "pagespeed": "node scripts/check.mjs pagespeed",
    "serve": "wrangler dev",
    "deploy": "npm run ci && wrangler deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "0.4.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "astro": "^7.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "postcss-custom-media": "^12.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.1.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261023.1": true
  }
}
