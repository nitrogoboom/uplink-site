// Cloudflare Workers, static assets only: the built site in dist/ is served as it is, with public/_headers. No
// Worker script runs.
//   npm run build && npx wrangler dev      serve dist/ the way Cloudflare does (http://localhost:8787)
//   npm run deploy                         build and deploy by hand; CI does the same on a push to main
// not_found_handling "404-page": an address with no file gets dist/404.html with a 404 status.
// html_handling (the default): /services serves services.html, and /services/ or /services.html redirect to it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uplink-site",
  // The newest date the installed wrangler supports; bump it when wrangler is updated.
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // The site's address. Custom Domains: Cloudflare makes the DNS records and certificates. www answers only so the
  // zone's redirect rule can send it to the bare name (docs/ops.md, "Domain"). Changing this list on deploy needs the
  // token's "Workers Routes: Edit" on the zone.
  "routes": [
    { "pattern": "jodesign.ca", "custom_domain": true },
    { "pattern": "www.jodesign.ca", "custom_domain": true },
  ],
  // the old address stays on until the site retires it (docs/release.md); previews live on workers.dev too
  "workers_dev": true,
  // each uploaded version gets its own address (a pull request's preview uses it)
  "preview_urls": true,
  "previews": {},
}
