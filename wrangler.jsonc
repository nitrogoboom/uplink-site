// Cloudflare Workers, static assets: the built site in dist/ is served as is, _headers and _redirects included.
//   npx wrangler dev      serve dist/ the way Cloudflare does (http://localhost:8787)
//   npx wrangler deploy   deploy by hand, in one step. CI deploys on a push to main another way: versions upload, a
//                         smoke check of that version, then versions deploy (scripts/deploy.mjs). That way doesn't
//                         apply routes, custom domains, cron triggers, workers_dev or preview_urls from this file:
//                         after a change to those, run `npx wrangler triggers deploy` or `npx wrangler deploy` once.
//                         preview_urls must stay true: the deploy checks each version at its preview address.
// The one script, worker/index.js, runs only where the files can't answer well on their own; everything else never
// starts it (no Worker time, no log line, nothing counted against the free plan's 100,000 requests a day):
//   run_worker_first   /api/* (the reports from visitors' browsers) and /404 by name (a file, so it would be 200)
//   not_found_handling "none": an address with no file goes to the Worker, which answers with dist/404.html, a 404
//                      status and /404's headers. "404-page" would serve that page from the assets without the Worker,
//                      but with the _headers rules of the missing path (a missing .txt as text/plain, a missing
//                      /_astro/ file cached for a year): review B8.
// build.command runs before every wrangler dev, deploy and versions upload. It builds nothing: it refuses dist/ if
// the build's last step (scripts/headers.mjs, called from astro.config.mjs) didn't finish, as after a build that
// stopped part way, so _headers never ships with its placeholders in the CSP (scripts/check-dist.mjs).
// To put the password lock back, see tools/site-lock/worker.js.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uplink-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "build": { "command": "node scripts/check-dist.mjs" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/404"],
  },
  // /api/report: 30 posts a minute per visitor address (worker/index.js). PR #38 (open, paused) adds a FORMS limit, namespace 1001.
  "ratelimits": [{ "name": "REPORTS", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }],
  "preview_urls": true,
  // Worker Previews (CI's preview job runs `wrangler preview`): the block must be here. A preview takes the assets
  // and the settings above, but not the bindings: REPORTS is named again so /api/report is limited there too
  "previews": {
    "ratelimits": [{ "name": "REPORTS", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }],
  },
  // The script's own console.log lines (one per report, worker/index.js) are kept, 3 days on the free plan. Cloudflare's
  // own record of each run (the invocation log: the request and response, headers included) is off: we don't need it.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
